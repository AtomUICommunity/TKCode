<!-- 一轮结束后的改动卡片：“N 个文件已更改 +X −Y”，整轮撤销；每个文件可审查（进入变更面板）或打开。
     文件超过预览数量时默认只列前几个，底部“还有 N 个文件”展开其余。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:loc="using:TKCode.Desktop.Localization"
             xmlns:motion="using:TKCode.Desktop.Motion"
             x:Class="TKCode.Desktop.Views.TurnChangesView"
             x:DataType="vm:TurnChangesItemViewModel">
    <Border Background="{DynamicResource TKCode.CardBg}" BorderBrush="{DynamicResource TKCode.TreeLine}"
            BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="6,4,6,4">
                <Button Theme="{StaticResource TKCode.ChipButton}" Padding="6,2,8,2" Command="{Binding ToggleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:LucideIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center"
                                          motion:Turn.IsOn="{Binding !IsExpanded}" />
                        <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Stats}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TKCode.TextSecondary}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Theme="{StaticResource TKCode.ChipButton}" Padding="8,2"
                        Command="{Binding RevertAllCommand}" IsEnabled="{Binding CanRevertAll}">
                    <TextBlock Text="{loc:TKCodeLangResource ChangesRevert}" FontSize="12" />
                </Button>
            </Grid>
            <StackPanel IsVisible="{Binding IsExpanded}" Margin="0,0,0,6">
                <ItemsControl ItemsSource="{Binding VisibleFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileChangeViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,3,10,3">
                                <Border Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <icons:FileTypeIcon Kind="{Binding Icon}" ColorKey="{Binding IconColor}" Width="14" Height="14"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TKCode.TextPrimary}" />
                                    <TextBlock Text="{Binding Error}" FontSize="11" IsVisible="{Binding HasError}"
                                               Foreground="{DynamicResource TKCode.Danger}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Stats}" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{DynamicResource TKCode.TextSecondary}" />
                                <Button Grid.Column="3" Theme="{StaticResource TKCode.ChipButton}" Padding="6,1"
                                        Command="{Binding $parent[UserControl].DataContext.ReviewCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="{loc:TKCodeLangResource ChangesReview}" FontSize="12" />
                                </Button>
                                <Button Grid.Column="4" Theme="{StaticResource TKCode.ChipButton}" Padding="6,1" Margin="4,0,0,0"
                                        Command="{Binding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="{loc:TKCodeLangResource ChangesOpen}" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Theme="{StaticResource TKCode.TextButton}" Margin="4,1,10,2" Padding="6,1"
                        IsVisible="{Binding HasOverflow}" Command="{Binding ToggleRestCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:LucideIcon Kind="ChevronRight" Width="12" Height="12" VerticalAlignment="Center"
                                          motion:Turn.IsOn="{Binding ShowAll}" />
                        <TextBlock Text="{Binding RestLabel}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
