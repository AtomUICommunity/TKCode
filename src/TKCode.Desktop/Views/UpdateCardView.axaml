<!--
  应用内更新的提醒卡片（docs/design/auto-update.md §9）：窗口右下角，不自动消失。
  发现新版本 → 下载中（进度条）→ 已就绪（安装并重启）；安装前有运行中的会话时切换为确认内容。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.UpdateCardView"
             x:DataType="vm:UpdatesViewModel">
    <Border Classes="menu" Width="340" Padding="14,12">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <icons:LucideIcon Kind="{Binding CardIcon}" Width="15" Height="15" VerticalAlignment="Center" StrokeBrush="{DynamicResource TKCode.Accent}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Classes="strong" Text="{Binding CardTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Border CornerRadius="4" Padding="5,0" Background="{DynamicResource TKCode.AccentSoftBg}" VerticalAlignment="Center"
                            IsVisible="{Binding IsPreview}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TKCode.AccentText}" Text="{loc:TKCodeLangResource UpdatePreviewTag}" />
                    </Border>
                </StackPanel>
                <arc:Button Classes="icon" Variant="Ghost" Grid.Column="2" Size="Small" Command="{Binding LaterCommand}"
                            arc:Tooltip.Tip="{loc:TKCodeLangResource UpdateClose}" VerticalAlignment="Top" Margin="0,-4,-6,0" AutomationProperties.Name="{loc:TKCodeLangResource UpdateClose}">
                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="X" />
                </arc:Button>
            </Grid>

            <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding CardBody}" IsVisible="{Binding HasCardBody}" />
            <arc:Progress Maximum="1" Value="{Binding Service.Progress}" IsValueVisible="False" IsVisible="{Binding IsDownloadingCard}" />

            <!-- 发现新版本 -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsAvailableCard}">
                <Panel Margin="-6,0,0,0">
                    <arc:Button Variant="Ghost" Size="Small" Command="{Binding ShowNotesCommand}"
                                Content="{loc:TKCodeLangResource UpdateViewNotes}" IsVisible="{Binding HasNotes}" />
                    <arc:Button Variant="Ghost" Size="Small" Command="{Binding OpenReleasePageCommand}"
                                Content="{loc:TKCodeLangResource UpdateViewNotes}" IsVisible="{Binding !HasNotes}" />
                </Panel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <arc:Button Variant="Ghost" Size="Small" Command="{Binding SkipCommand}" Content="{loc:TKCodeLangResource UpdateSkip}" />
                    <arc:Button Variant="Primary" Size="Small" Command="{Binding DownloadCommand}" Content="{loc:TKCodeLangResource UpdateAction}"
                                IsVisible="{Binding CanInstallInApp}" />
                    <arc:Button Variant="Primary" Size="Small" Command="{Binding OpenReleasePageCommand}" Content="{loc:TKCodeLangResource UpdateOpenPage}"
                                IsVisible="{Binding !CanInstallInApp}" />
                </StackPanel>
            </Grid>

            <!-- 已就绪 / 上次更新未完成 -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding IsReadyCard}">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding LaterCommand}" Content="{loc:TKCodeLangResource UpdateLater}" />
                <arc:Button Variant="Primary" Size="Small" Command="{Binding InstallCommand}" Content="{loc:TKCodeLangResource UpdateInstallRestart}" />
            </StackPanel>

            <!-- 失败 -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding IsFailedCard}">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding LaterCommand}" Content="{loc:TKCodeLangResource UpdateClose}" />
                <arc:Button Variant="Primary" Size="Small" Command="{Binding RetryCommand}" Content="{loc:TKCodeLangResource UpdateRetry}" />
            </StackPanel>

            <!-- 安装前确认运行中的会话 -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding IsConfirmCard}">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding CancelInstallCommand}" Content="{loc:TKCodeLangResource UpdateCancel}" />
                <arc:Button Variant="Secondary" Size="Small" Command="{Binding InstallNowCommand}" Content="{loc:TKCodeLangResource UpdateInstallNow}" />
                <arc:Button Variant="Primary" Size="Small" Command="{Binding InstallWhenIdleCommand}" Content="{loc:TKCodeLangResource UpdateInstallWhenIdle}" />
            </StackPanel>

            <!-- 等待会话结束 -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding IsWaitingCard}">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding CancelInstallCommand}" Content="{loc:TKCodeLangResource UpdateCancel}" />
            </StackPanel>

            <!-- 已更新 -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding IsUpdatedCard}">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding ShowNotesCommand}" Content="{loc:TKCodeLangResource UpdateViewNotes}"
                            IsVisible="{Binding HasNotes}" />
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding OpenReleasePageCommand}" Content="{loc:TKCodeLangResource UpdateViewNotes}"
                            IsVisible="{Binding !HasNotes}" />
                <arc:Button Variant="Primary" Size="Small" Command="{Binding LaterCommand}" Content="{loc:TKCodeLangResource UpdateClose}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
