<!-- 工具步骤展开后的内容：完整参数；有 diff 时显示着色 diff，否则显示输出（命令的实时输出 / 子 Agent 的当前动作）。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:views="using:TKCode.Desktop.Views"
             x:Class="TKCode.Desktop.Views.ToolCallDetailView"
             x:DataType="vm:ToolCallBlockViewModel">
    <StackPanel Margin="38,2,8,10" Spacing="8">
        <StackPanel.Styles>
            <Style Selector="SelectableTextBlock.output.failed">
                <Setter Property="Foreground" Value="{DynamicResource TKCode.Danger}" />
            </Style>
        </StackPanel.Styles>
        <!-- 命令全文限高，超出内部滚动（长命令不撑开行）；参数流式输出时贴底 -->
        <arc:ScrollArea MaxHeight="120" controls:FollowTail.IsEnabled="{Binding IsStreaming}">
            <SelectableTextBlock Text="{Binding Detail}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12"
                                 LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource TKCode.TextSecondary}" />
        </arc:ScrollArea>
        <!-- 子 Agent：名字、工具调用次数与 tokens -->
        <TextBlock Classes="tertiary" FontSize="12" Text="{Binding SubagentStats}" IsVisible="{Binding HasSubagent}" />
        <!-- 文件改动：+3 −1 与着色 diff（与变更面板同一控件） -->
        <StackPanel IsVisible="{Binding HasDiff}" Spacing="6">
            <TextBlock Classes="tertiary" FontSize="12" Text="{Binding DiffStats}" />
            <views:DiffView Lines="{Binding DiffLines}" MaxContentHeight="320" />
        </StackPanel>
        <Border IsVisible="{Binding ShowResult}" Background="{DynamicResource TKCode.CodeBg}" CornerRadius="6" Padding="10,8">
            <arc:ScrollArea MaxHeight="240"
                            controls:FollowTail.IsEnabled="{Binding IsBusy}">
                <SelectableTextBlock Classes="output" Classes.failed="{Binding IsFailed}" Text="{Binding Result}"
                                     FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12" TextWrapping="Wrap" />
            </arc:ScrollArea>
        </Border>
    </StackPanel>
</UserControl>
