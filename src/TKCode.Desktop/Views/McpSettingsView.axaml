<!--
  设置 › MCP 服务器：主从双栏（docs/design/mcp.md §11）。
  左栏：搜索 + “全局 / 项目”两组服务器 + 添加；右栏：选中服务器的连接表单、状态、工具与日志。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.McpSettingsView"
             x:DataType="vm:McpSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="Foreground" Value="{DynamicResource TKCode.TextTertiary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="10,12,0,4" />
        </Style>
        <!-- 状态徽标：默认中性色，按服务器状态换成成功 / 警告 / 危险色 -->
        <Style Selector="arc|Badge.ok">
            <Setter Property="Tone" Value="Success" />
        </Style>
        <Style Selector="arc|Badge.warn">
            <Setter Property="Tone" Value="Warning" />
        </Style>
        <Style Selector="arc|Badge.bad">
            <Setter Property="Tone" Value="Danger" />
        </Style>
        <Style Selector="arc|Textarea.multiline">
            <Setter Property="FontFamily" Value="{StaticResource TKCode.MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="248,*" Margin="24,0,24,0">
        <!-- ======== 左栏：服务器列表 ======== -->
        <Border Classes="card" Margin="0,0,0,24">
            <DockPanel>
                <arc:SearchField DockPanel.Dock="Top" Size="Small" Margin="8,8,8,0"
                                 Label="{loc:TKCodeLangResource SearchMcpServers}" IsLabelVisible="False"
                                 Placeholder="{loc:TKCodeLangResource SearchMcpServers}" ClearText="{loc:TKCodeLangResource ClearSearch}"
                                 Text="{Binding Search, Mode=TwoWay}" />
                <StackPanel DockPanel.Dock="Bottom" Margin="6">
                    <Button Theme="{StaticResource TKCode.RowButton}" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:LucideIcon Kind="Plus" Width="14" Height="14" />
                            <TextBlock Text="{loc:TKCodeLangResource AddMcpServer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid ColumnDefinitions="*,*">
                        <Button Theme="{StaticResource TKCode.RowButton}" Command="{Binding OpenImportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:LucideIcon Kind="Download" Width="14" Height="14" />
                                <TextBlock Text="{loc:TKCodeLangResource ImportMcp}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Theme="{StaticResource TKCode.RowButton}" Command="{Binding OpenExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:LucideIcon Kind="Upload" Width="14" Height="14" />
                                <TextBlock Text="{loc:TKCodeLangResource ExportMcp}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource TKCode.Divider}" />
                <!-- Arc 浮动滚动条：右侧留出 10px，悬停时它不会盖住状态点 -->
                <arc:ScrollArea>
                    <StackPanel Margin="6,0,10,6">
                        <TextBlock Classes="groupLabel" Text="{loc:TKCodeLangResource McpGlobalGroup}" />
                        <ItemsControl ItemsSource="{Binding GlobalServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpServerItemViewModel">
                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="32" Margin="0,1"
                                            Command="{Binding $parent[UserControl].((vm:McpSettingsViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}" arc:Tooltip.Tip="{Binding StatusText}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <icons:LucideIcon Kind="Plug" Width="14" Height="14" StrokeBrush="{DynamicResource TKCode.TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding ToolCountText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Panel Grid.Column="3" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.Success}" IsVisible="{Binding IsOk}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.GitModified}" IsVisible="{Binding IsBusy}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.GitModified}" IsVisible="{Binding IsWarn}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.Danger}" IsVisible="{Binding IsError}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.TextTertiary}" IsVisible="{Binding IsOff}" />
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <arc:EmptyState Icon="{lucide:LucideGeometry Kind=Plug}" Description="{loc:TKCodeLangResource McpNoServers}"
                                        Margin="0,16,0,0" IsVisible="{Binding HasNoServers}" />

                        <StackPanel IsVisible="{Binding HasProjectServers}">
                            <TextBlock Classes="groupLabel" Text="{Binding ProjectGroupTitle}" />
                            <ItemsControl ItemsSource="{Binding ProjectServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpServerItemViewModel">
                                        <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="32" Margin="0,1"
                                                Command="{Binding $parent[UserControl].((vm:McpSettingsViewModel)DataContext).SelectCommand}"
                                                CommandParameter="{Binding}" arc:Tooltip.Tip="{Binding StatusText}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <icons:LucideIcon Kind="Folder" Width="14" Height="14" StrokeBrush="{DynamicResource TKCode.TextSecondary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding ToolCountText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <Panel Grid.Column="3" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.Success}" IsVisible="{Binding IsOk}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.GitModified}" IsVisible="{Binding IsBusy}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.GitModified}" IsVisible="{Binding IsWarn}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.Danger}" IsVisible="{Binding IsError}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.TextTertiary}" IsVisible="{Binding IsOff}" />
                                                </Panel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </arc:ScrollArea>
            </DockPanel>
        </Border>

        <!-- ======== 右栏 ======== -->
        <arc:ScrollArea Grid.Column="1" Margin="16,0,0,0">
            <StackPanel MaxWidth="820" Spacing="14" Margin="0,0,16,24">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:TKCodeLangResource SettingsMcp}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpHint}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <arc:Alert Tone="Danger" Content="{Binding ProjectError}" IsVisible="{Binding HasProjectError}" />

                <arc:EmptyState Icon="{lucide:LucideGeometry Kind=Plug}" Title="{loc:TKCodeLangResource SelectMcpHint}" Margin="0,40,0,0"
                                IsVisible="{Binding ShowEmptyDetail}" />

                <ContentControl Content="{Binding Selected}" IsVisible="{Binding HasSelection}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:McpServerDetailViewModel">
                            <StackPanel Spacing="14">
                                <!-- 标题 -->
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                    <icons:LucideIcon Kind="Plug" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                                    <arc:Badge Grid.Column="2" Size="Small" VerticalAlignment="Center" IsVisible="{Binding IsExisting}"
                                               Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"
                                               Content="{Binding StatusText}" />
                                    <arc:Switch Grid.Column="4" VerticalAlignment="Center" IsVisible="{Binding IsExisting}"
                                                       IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleEnabledCommand}"
                                                       arc:Tooltip.Tip="{loc:TKCodeLangResource McpEnableServer}" />
                                    <arc:Button Grid.Column="5" Margin="8,0,0,0" Variant="Ghost" Size="Small" IsVisible="{Binding IsExisting}"
                                                Command="{Binding RemoveCommand}" arc:Tooltip.Tip="{loc:TKCodeLangResource Remove}"
                                                AutomationProperties.Name="{loc:TKCodeLangResource Remove}">
                                        <lucide:LucideIcon Kind="Trash2" Size="14" />
                                    </arc:Button>
                                </Grid>

                                <!-- 状态与操作 -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsExisting}">
                                    <TextBlock Classes="tertiary" Text="{Binding ServerInfo}" IsVisible="{Binding HasServerInfo}" />
                                    <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource McpShadowedHint}" IsVisible="{Binding ShadowedGlobal}" />
                                    <arc:Alert Tone="Danger" IsVisible="{Binding HasStatusError}">
                                        <SelectableTextBlock Text="{Binding StatusError}" FontSize="12" TextWrapping="Wrap" />
                                    </arc:Alert>
                                    <arc:Alert Tone="Warning" Content="{Binding MissingVariables}" IsVisible="{Binding HasMissingVariables}" />
                                    <arc:Alert Tone="Warning" IsVisible="{Binding IsUntrusted}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:TKCodeLangResource McpUntrustedHint}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                                                <arc:Button Variant="Ghost" Size="Small" Command="{Binding IgnoreCommand}"
                                                            Content="{loc:TKCodeLangResource McpIgnore}" />
                                                <arc:Button Variant="Primary" Size="Small" Command="{Binding TrustCommand}"
                                                            Content="{loc:TKCodeLangResource McpTrust}" />
                                            </StackPanel>
                                        </Grid>
                                    </arc:Alert>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <arc:Button Variant="Secondary" Size="Small" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <lucide:LucideIcon Kind="RefreshCw" Size="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:TKCodeLangResource McpRestart}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </arc:Button>
                                        <arc:Button Variant="Primary" Size="Small" Command="{Binding LoginCommand}" IsVisible="{Binding NeedsLogin}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <lucide:LucideIcon Kind="LogIn" Size="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:TKCodeLangResource McpLogin}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </arc:Button>
                                        <arc:Button Variant="Ghost" Size="Small" Command="{Binding LogoutCommand}" IsVisible="{Binding CanLogin}"
                                                    Content="{loc:TKCodeLangResource McpLogout}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 连接 -->
                                <Border Classes="card" Padding="16,14">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="sectionTitle" Text="{loc:TKCodeLangResource ConnectionLabel}" />
                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpServerNameLabel}" VerticalAlignment="Center" />
                                            <arc:Input Grid.Column="1" Placeholder="github" Text="{Binding NameInput, Mode=TwoWay}" FontFamily="{StaticResource TKCode.MonoFont}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100,*" IsVisible="{Binding CanChooseScope}">
                                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpScopeLabel}" VerticalAlignment="Center" />
                                            <arc:SegmentedControl Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding ScopeChoices}"
                                                                  controls:ChoiceSelection.Command="{Binding ChooseScopeCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpTransportLabel}" VerticalAlignment="Center" />
                                            <arc:SegmentedControl Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding TransportChoices}"
                                                                  controls:ChoiceSelection.Command="{Binding ChooseTransportCommand}" />
                                        </Grid>
                                        <!-- 本地命令 -->
                                        <StackPanel Spacing="12" IsVisible="{Binding IsLocal}">
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpCommandLabel}" VerticalAlignment="Center" />
                                                <arc:Input Grid.Column="1" Placeholder="npx" Text="{Binding CommandInput, Mode=TwoWay}" FontFamily="{StaticResource TKCode.MonoFont}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpArgsLabel}" VerticalAlignment="Top" Margin="0,10,0,0" />
                                                <arc:Textarea Grid.Column="1" Classes="multiline" Label="{loc:TKCodeLangResource McpArgsLabel}" IsLabelVisible="False"
                                                              Description="{loc:TKCodeLangResource McpArgsHint}" Text="{Binding ArgsInput, Mode=TwoWay}"
                                                              Placeholder="-y&#x0a;@modelcontextprotocol/server-filesystem" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpCwdLabel}" VerticalAlignment="Center" />
                                                <arc:Input Grid.Column="1" Placeholder="{loc:TKCodeLangResource McpCwdPlaceholder}" Text="{Binding CwdInput, Mode=TwoWay}"
                                                               FontFamily="{StaticResource TKCode.MonoFont}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpEnvLabel}" VerticalAlignment="Top" Margin="0,10,0,0" />
                                                <arc:Textarea Grid.Column="1" Classes="multiline" Label="{loc:TKCodeLangResource McpEnvLabel}" IsLabelVisible="False"
                                                              Description="{loc:TKCodeLangResource McpEnvHint}" Text="{Binding EnvInput, Mode=TwoWay}"
                                                              Placeholder="API_KEY={env:MY_API_KEY}" />
                                            </Grid>
                                        </StackPanel>
                                        <!-- 远程 URL -->
                                        <StackPanel Spacing="12" IsVisible="{Binding IsRemote}">
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpUrlLabel}" VerticalAlignment="Center" />
                                                <arc:Input Grid.Column="1" Placeholder="https://example.com/mcp" Text="{Binding UrlInput, Mode=TwoWay}"
                                                               FontFamily="{StaticResource TKCode.MonoFont}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource McpHeadersLabel}" VerticalAlignment="Top" Margin="0,10,0,0" />
                                                <arc:Textarea Grid.Column="1" Classes="multiline" Label="{loc:TKCodeLangResource McpHeadersLabel}" IsLabelVisible="False"
                                                              Description="{loc:TKCodeLangResource McpHeadersHint}" Text="{Binding HeadersInput, Mode=TwoWay}"
                                                              Placeholder="Authorization: Bearer {env:TOKEN}" />
                                            </Grid>
                                        </StackPanel>
                                        <arc:Alert Tone="Danger" Content="{Binding Error}" IsVisible="{Binding HasError}" />
                                        <Border Height="1" Background="{DynamicResource TKCode.Divider}" Margin="-16,2" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <arc:Button Variant="Secondary" Size="Small" Command="{Binding TestCommand}" IsLoading="{Binding IsTesting}"
                                                        Content="{loc:TKCodeLangResource TestConnection}" />
                                            <Panel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" IsVisible="{Binding HasTestResult}">
                                                <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="{DynamicResource TKCode.Success}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding TestSucceeded}" arc:Tooltip.Tip="{Binding TestResult}" />
                                                <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !TestSucceeded}" arc:Tooltip.Tip="{Binding TestResult}" />
                                            </Panel>
                                            <TextBlock Grid.Column="2" Classes="tertiary" Text="{loc:TKCodeLangResource Unsaved}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsDirty}" />
                                            <arc:Button Grid.Column="3" Variant="Primary" Size="Small" Command="{Binding SaveCommand}"
                                                        Content="{loc:TKCodeLangResource Save}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 服务器说明 -->
                                <Border Classes="card" Padding="16,14" IsVisible="{Binding HasInstructions}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="sectionTitle" Text="{loc:TKCodeLangResource McpInstructionsLabel}" />
                                        <SelectableTextBlock Text="{Binding Instructions}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TKCode.TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- 工具 -->
                                <Border Classes="card" Padding="16,14" IsVisible="{Binding IsExisting}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Classes="sectionTitle" Text="{loc:TKCodeLangResource McpToolsLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="tertiary" Text="{Binding ToolsSummary}" Margin="10,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasTools}" />
                                            <arc:Button Grid.Column="2" Variant="Ghost" Size="Small" Command="{Binding LoadToolsCommand}"
                                                        IsLoading="{Binding IsLoadingTools}" arc:Tooltip.Tip="{loc:TKCodeLangResource McpRestart}"
                                                        AutomationProperties.Name="{loc:TKCodeLangResource McpRestart}">
                                                <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                                            </arc:Button>
                                        </Grid>
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource McpAnnotationsHint}" IsVisible="{Binding HasTools}" />
                                        <TextBlock Classes="secondary" FontSize="12" Text="{loc:TKCodeLangResource McpToolsEmpty}" IsVisible="{Binding HasNoTools}" />
                                        <ItemsControl ItemsSource="{Binding Tools}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:McpToolItemViewModel">
                                                    <Border BorderBrush="{DynamicResource TKCode.Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                                <arc:Switch VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                                <Button Grid.Column="1" Theme="{StaticResource TKCode.RowButton}" Margin="8,0" Padding="4,2" Command="{Binding ToggleExpandedCommand}"
                                                                        HorizontalContentAlignment="Left">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Classes="strong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Classes="tertiary" Text="{Binding Name}" FontFamily="{StaticResource TKCode.MonoFont}" IsVisible="{Binding ShowName}" />
                                                                        <arc:Badge Size="Small" VerticalAlignment="Center" IsVisible="{Binding Dto.ReadOnlyHint}"
                                                                                   Content="{loc:TKCodeLangResource McpReadOnlyTag}" />
                                                                        <arc:Badge Size="Small" VerticalAlignment="Center" Tone="Danger" IsVisible="{Binding Dto.DestructiveHint}"
                                                                                   Content="{loc:TKCodeLangResource McpDestructiveTag}" />
                                                                        <arc:Badge Size="Small" VerticalAlignment="Center" IsVisible="{Binding Dto.OpenWorldHint}"
                                                                                   Content="{loc:TKCodeLangResource McpOpenWorldTag}" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding TokensText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                <arc:Checkbox Grid.Column="3" IsChecked="{Binding AlwaysAllow, Mode=TwoWay}" Content="{loc:TKCodeLangResource McpAlwaysAllow}"
                                                                               VerticalAlignment="Center" />
                                                            </Grid>
                                                            <SelectableTextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="46,0,0,0"
                                                                                 Foreground="{DynamicResource TKCode.TextSecondary}" MaxLines="2"
                                                                                 IsVisible="{Binding !IsExpanded}" />
                                                            <SelectableTextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="46,0,0,0"
                                                                                 Foreground="{DynamicResource TKCode.TextSecondary}" IsVisible="{Binding IsExpanded}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 日志 -->
                                <Border Classes="card" Padding="16,14" IsVisible="{Binding IsExisting}">
                                    <StackPanel Spacing="8">
                                        <arc:Button Variant="Ghost" Size="Small" Command="{Binding ToggleLogCommand}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <lucide:LucideIcon Kind="ChevronRight" Size="12" VerticalAlignment="Center" IsVisible="{Binding !ShowLog}" />
                                                <lucide:LucideIcon Kind="ChevronDown" Size="12" VerticalAlignment="Center" IsVisible="{Binding ShowLog}" />
                                                <TextBlock Text="{loc:TKCodeLangResource McpLogLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </arc:Button>
                                        <StackPanel IsVisible="{Binding ShowLog}">
                                            <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource McpLogEmpty}" IsVisible="{Binding !HasLog}" />
                                            <arc:ScrollArea MaxHeight="260" IsVisible="{Binding HasLog}">
                                                <ItemsControl ItemsSource="{Binding LogLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <SelectableTextBlock Text="{Binding}" FontSize="11" FontFamily="{StaticResource TKCode.MonoFont}" TextWrapping="Wrap"
                                                                                 Foreground="{DynamicResource TKCode.TextSecondary}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </arc:ScrollArea>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </arc:ScrollArea>
    </Grid>

</UserControl>
