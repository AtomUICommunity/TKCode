<!--
  权限选择器：芯片（盾牌图标 + 当前档位）+ 弹层（三档）。
  选择“完全授权”时弹层切换为确认卡片，确认后才生效。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:motion="using:TKCode.Desktop.Motion"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.PermissionPickerView"
             x:DataType="vm:PermissionPickerViewModel">
    <UserControl.Styles>
        <Style Selector="Button#Chip.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TKCode.Danger}" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <Button x:Name="Chip" Theme="{StaticResource TKCode.ChipButton}" Classes.selected="{Binding #Popup.IsOpen}"
                Classes.danger="{Binding IsFullAccess}"
                Padding="6,0" VerticalAlignment="Center" Click="OnChipClick" ToolTip.Tip="{loc:TKCodeLangResource PermissionTitle}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <!-- AtomUI 图标的画笔只认本地值：每档一个图标，按档位显示 -->
                <Panel Width="14" Height="14" VerticalAlignment="Center">
                    <icons:LucideIcon Kind="ShieldQuestion" StrokeBrush="{DynamicResource TKCode.TextSecondary}" IsVisible="{Binding IsAsk}" />
                    <icons:LucideIcon Kind="ShieldCheck" StrokeBrush="{DynamicResource TKCode.AccentText}" IsVisible="{Binding IsAutoApprove}" />
                    <icons:LucideIcon Kind="ShieldAlert" StrokeBrush="{DynamicResource TKCode.Danger}" IsVisible="{Binding IsFullAccess}" />
                </Panel>
                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="{loc:TKCodeLangResource PermissionAsk}" IsVisible="{Binding IsAsk}" />
                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="{loc:TKCodeLangResource PermissionAuto}" IsVisible="{Binding IsAutoApprove}" />
                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="{loc:TKCodeLangResource PermissionFull}" IsVisible="{Binding IsFullAccess}" />
            </StackPanel>
        </Button>

        <motion:Popover x:Name="Popup" PlacementTarget="{Binding #Chip}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
               IsLightDismissEnabled="True" Closed="OnPopupClosed">
            <controls:ZoomHost>
            <Border Classes="menu" Width="300" Margin="0,0,24,24">
                <!-- 三档 ↔ 二次确认：交叉淡入，弹层高度平滑过渡 -->
                <motion:SmoothSize>
                <Panel>
                    <!-- 三档 -->
                    <StackPanel Margin="4" motion:Presence.IsPresent="{Binding !IsConfirmingFullAccess}" motion:Presence.Effect="SlideRight">
                        <TextBlock Classes="tertiary" FontSize="11" Margin="8,4,8,6" Text="{loc:TKCodeLangResource PermissionTitle}" />
                        <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsAsk}" MinHeight="44" Margin="0,1"
                                Command="{Binding ChooseCommand}" CommandParameter="ask">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <icons:LucideIcon Kind="ShieldQuestion" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Classes="strong" Text="{loc:TKCodeLangResource PermissionAsk}" />
                                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:TKCodeLangResource PermissionAskDesc}" />
                                </StackPanel>
                                <icons:LucideIcon Grid.Column="2" Kind="Check" Width="13" Height="13" Margin="8,0,0,0" IsVisible="{Binding IsAsk}" />
                            </Grid>
                        </Button>
                        <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsAutoApprove}" MinHeight="44" Margin="0,1"
                                Command="{Binding ChooseCommand}" CommandParameter="autoApprove">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <icons:LucideIcon Kind="ShieldCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  StrokeBrush="{DynamicResource TKCode.AccentText}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Classes="strong" Text="{loc:TKCodeLangResource PermissionAuto}" />
                                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:TKCodeLangResource PermissionAutoDesc}" />
                                </StackPanel>
                                <icons:LucideIcon Grid.Column="2" Kind="Check" Width="13" Height="13" Margin="8,0,0,0" IsVisible="{Binding IsAutoApprove}" />
                            </Grid>
                        </Button>
                        <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsFullAccess}" MinHeight="44" Margin="0,1"
                                Command="{Binding ChooseCommand}" CommandParameter="fullAccess">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <icons:LucideIcon Kind="ShieldAlert" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  StrokeBrush="{DynamicResource TKCode.Danger}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Classes="strong" Foreground="{DynamicResource TKCode.Danger}" Text="{loc:TKCodeLangResource PermissionFull}" />
                                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:TKCodeLangResource PermissionFullDesc}" />
                                </StackPanel>
                                <icons:LucideIcon Grid.Column="2" Kind="Check" Width="13" Height="13" Margin="8,0,0,0" IsVisible="{Binding IsFullAccess}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 完全授权：二次确认 -->
                    <StackPanel Margin="14,12" Spacing="10" VerticalAlignment="Top"
                                motion:Presence.IsPresent="{Binding IsConfirmingFullAccess}" motion:Presence.Effect="SlideLeft">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:LucideIcon Kind="ShieldAlert" Width="16" Height="16" VerticalAlignment="Center"
                                              StrokeBrush="{DynamicResource TKCode.Danger}" />
                            <TextBlock Classes="strong" VerticalAlignment="Center" Text="{loc:TKCodeLangResource PermissionFullConfirmTitle}" />
                        </StackPanel>
                        <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:TKCodeLangResource PermissionFullConfirmText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <arc:Button Variant="Ghost" Size="Small" Command="{Binding CancelConfirmCommand}"
                                        Content="{loc:TKCodeLangResource Cancel}" />
                            <arc:Button Variant="Danger" x:Name="ConfirmFullAccess" Size="Small"
                                        Command="{Binding ConfirmFullAccessCommand}"
                                        Content="{loc:TKCodeLangResource PermissionFullConfirm}" />
                        </StackPanel>
                    </StackPanel>
                </Panel>
                </motion:SmoothSize>
            </Border>
            </controls:ZoomHost>
        </motion:Popover>
    </Panel>
</UserControl>
