<!--
  空状态输入框上方的项目选择：触发按钮（文件夹图标 + 名称 + ⌄）+ 弹层（搜索 / 项目列表 / 新建项目… / 不使用项目）。
  「新建项目…」打开创建项目弹窗（docs/design/projects.md §8.4）。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:motion="using:TKCode.Desktop.Motion"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:views="using:TKCode.Desktop.Views"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.ProjectPickerView"
             x:DataType="vm:ProjectPickerViewModel">
    <Panel>
        <Button x:Name="Trigger" Theme="{StaticResource TKCode.ChipButton}" Classes.selected="{Binding #Popup.IsOpen}" Click="OnTriggerClick"
                ToolTip.Tip="{Binding Tip}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <icons:LucideIcon Kind="Folder" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" Margin="7,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <icons:LucideIcon Grid.Column="2" Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
            </Grid>
        </Button>

        <motion:Popover x:Name="Popup" PlacementTarget="{Binding #Trigger}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6" MinWidth="240"
               IsLightDismissEnabled="True" Opened="OnPopupOpened" Closed="OnPopupClosed">
            <controls:ZoomHost>
            <Border Classes="menu" Margin="0,0,16,16">
                <StackPanel Margin="4">
                    <Border Background="{DynamicResource TKCode.MenuInputBg}" CornerRadius="6" Margin="0,0,0,4">
                        <arc:Input x:Name="SearchBox" Classes="bare"
                                       Placeholder="{loc:TKCodeLangResource SearchProjects}" Text="{Binding Search, Mode=TwoWay}" />
                    </Border>
                    <arc:ScrollArea MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectItemViewModel">
                                    <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsSelected}" MinHeight="32" Margin="0,1"
                                            Command="{Binding $parent[UserControl].((vm:ProjectPickerViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Project.Primary, FallbackValue={x:Null}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="strong" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Classes="tertiary" Text="{Binding Meta}" Margin="12,0,0,0" FontSize="11"
                                                       VerticalAlignment="Center" IsVisible="{Binding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </arc:ScrollArea>
                    <Border Classes="menuDivider" Margin="-4,4" />
                    <Button Theme="{StaticResource TKCode.MenuItem}" MinHeight="32" Command="{Binding NewProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:LucideIcon Kind="Plus" Width="13" Height="13" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource NewProject}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Theme="{StaticResource TKCode.MenuItem}" MinHeight="32" Command="{Binding ChooseNoProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:LucideIcon Kind="X" Width="13" Height="13" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource NoProject}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            </controls:ZoomHost>
        </motion:Popover>
    </Panel>
</UserControl>
