<!--
  设置 › 模型与厂商：主从双栏。
  左栏：搜索 + “已启用 / 可添加”两组厂商 + 自定义厂商入口；右栏：选中厂商的连接表单与模型表（或自定义厂商表单）。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.ProvidersSettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="Foreground" Value="{DynamicResource TKCode.TextTertiary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="10,12,0,4" />
        </Style>
        <!-- 状态徽标：默认中性色，已连接时换成成功色 -->
        <Style Selector="arc|Badge.connected">
            <Setter Property="Tone" Value="Success" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="248,*" Margin="24,0,24,0">
        <!-- ======== 左栏：厂商列表 ======== -->
        <Border Classes="card" Margin="0,0,0,24">
            <DockPanel>
                <arc:SearchField DockPanel.Dock="Top" Size="Small" Margin="8,8,8,0"
                                 Label="{loc:TKCodeLangResource SearchProviders}" IsLabelVisible="False"
                                 Placeholder="{loc:TKCodeLangResource SearchProviders}" ClearText="{loc:TKCodeLangResource ClearSearch}"
                                 Text="{Binding ProviderSearch, Mode=TwoWay}" />
                <Button DockPanel.Dock="Bottom" Theme="{StaticResource TKCode.RowButton}" Margin="6" Classes.selected="{Binding IsPickingTemplate}"
                        Command="{Binding OpenTemplatePickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:LucideIcon Kind="Plus" Width="14" Height="14" />
                        <TextBlock Text="{loc:TKCodeLangResource AddProvider}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource TKCode.Divider}" />
                <!-- Arc 浮动滚动条：右侧留出 10px，悬停时它不会盖住状态点 -->
                <arc:ScrollArea>
                    <StackPanel Margin="6,0,10,6">
                        <TextBlock Classes="groupLabel" Text="{loc:TKCodeLangResource ProvidersConfigured}" />
                        <ItemsControl ItemsSource="{Binding ConfiguredList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderListItemViewModel">
                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="32" Margin="0,1"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectProviderCommand}"
                                            CommandParameter="{Binding}" arc:Tooltip.Tip="{Binding StatusText}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <icons:ProviderLogo Key="{Binding LogoKey}" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.Success}" IsVisible="{Binding IsOk}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.GitModified}" IsVisible="{Binding IsWarning}" />
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <arc:EmptyState Icon="{lucide:LucideGeometry Kind=Box}" Description="{loc:TKCodeLangResource NoConfiguredProviders}"
                                        Margin="0,16,0,0" IsVisible="{Binding HasNoProviders}" />
                    </StackPanel>
                </arc:ScrollArea>
            </DockPanel>
        </Border>

        <!-- ======== 右栏 ======== -->
        <arc:ScrollArea Grid.Column="1" Margin="16,0,0,0">
            <StackPanel MaxWidth="820" Spacing="14" Margin="0,0,16,24">
                <!-- 配置文件错误 -->
                <arc:Alert Tone="Danger" Title="{loc:TKCodeLangResource SettingsErrorsTitle}" IsVisible="{Binding HasErrors}">
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <SelectableTextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource TKCode.MonoFont}" TextWrapping="Wrap"
                                                     Foreground="{DynamicResource TKCode.TextSecondary}" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </arc:Alert>

                <arc:EmptyState Icon="{lucide:LucideGeometry Kind=Box}" Title="{loc:TKCodeLangResource SelectProviderHint}" Margin="0,40,0,0"
                                IsVisible="{Binding ShowEmptyDetail}" />

                <!-- ===== 自定义厂商 ===== -->
                <StackPanel Spacing="14" IsVisible="{Binding IsCreatingCustom}">
                    <TextBlock Text="{loc:TKCodeLangResource CustomProviderTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource CustomProviderHint}" TextWrapping="Wrap" FontSize="12" />
                    <Border Classes="card" Padding="16">
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto">
                            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                <TextBlock Classes="strong" Text="{loc:TKCodeLangResource ProtocolLabel}" />
                                <arc:SegmentedControl ItemsSource="{Binding Protocols}" controls:ChoiceSelection.Command="{Binding ChooseProtocolCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Classes="strong" Text="{loc:TKCodeLangResource ProviderIdLabel}" VerticalAlignment="Center" />
                            <arc:Input Grid.Row="2" Grid.Column="1" Placeholder="my-gateway" Text="{Binding CustomId, Mode=TwoWay}"
                                           FontFamily="{StaticResource TKCode.MonoFont}" />
                            <TextBlock Grid.Row="4" Classes="strong" Text="{loc:TKCodeLangResource ProviderNameLabel}" VerticalAlignment="Center" />
                            <arc:Input Grid.Row="4" Grid.Column="1" Placeholder="My Gateway" Text="{Binding CustomName, Mode=TwoWay}" />
                            <TextBlock Grid.Row="6" Classes="strong" Text="{loc:TKCodeLangResource BaseUrlLabel}" VerticalAlignment="Center" />
                            <arc:Input Grid.Row="6" Grid.Column="1" Placeholder="https://api.example.com/v1" Text="{Binding CustomBaseUrl, Mode=TwoWay}"
                                           FontFamily="{StaticResource TKCode.MonoFont}" />
                            <TextBlock Grid.Row="8" Classes="strong" Text="{loc:TKCodeLangResource ApiKeyLabel}" VerticalAlignment="Center" />
                            <arc:PasswordField Grid.Row="8" Grid.Column="1" Label="{loc:TKCodeLangResource ApiKeyLabel}" IsLabelVisible="False"
                                               Placeholder="{loc:TKCodeLangResource ApiKeyPlaceholder}" Text="{Binding CustomApiKey, Mode=TwoWay}"
                                               ShowPasswordText="{loc:TKCodeLangResource ShowKey}" HidePasswordText="{loc:TKCodeLangResource HideKey}" />
                        </Grid>
                    </Border>
                    <arc:Alert Tone="Danger" Content="{Binding CustomError}" IsVisible="{Binding CustomError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <arc:Button HorizontalAlignment="Right" Variant="Primary" Command="{Binding CreateCustomProviderCommand}"
                                Content="{loc:TKCodeLangResource CreateProvider}" />
                </StackPanel>

                <!-- ===== 厂商详情 ===== -->
                <ContentControl Content="{Binding Selected}" IsVisible="{Binding HasSelection}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ProviderDetailViewModel">
                            <StackPanel Spacing="14">
                                <!-- 标题 -->
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                    <icons:ProviderLogo Key="{Binding LogoKey}" Width="26" Height="26" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                                    <arc:Badge Grid.Column="2" Size="Small" VerticalAlignment="Center" Classes.connected="{Binding IsOk}"
                                               Content="{Binding StatusText}" />
                                    <arc:Switch Grid.Column="4" VerticalAlignment="Center" IsVisible="{Binding ShowEnableSwitch}"
                                                       IsChecked="{Binding Dto.Enabled, Mode=OneWay}" Command="{Binding ToggleEnabledCommand}"
                                                       arc:Tooltip.Tip="{loc:TKCodeLangResource EnableProvider}" />
                                    <arc:Button Grid.Column="5" Margin="8,0,0,0" Variant="Ghost" Size="Small" Command="{Binding RemoveCommand}"
                                                arc:Tooltip.Tip="{Binding RemoveTooltip}" AutomationProperties.Name="{Binding RemoveTooltip}">
                                        <lucide:LucideIcon Kind="Trash2" Size="14" />
                                    </arc:Button>
                                </Grid>
                                <arc:Badge Size="Small" HorizontalAlignment="Left" IsVisible="{Binding IsDraft}" Content="{loc:TKCodeLangResource DraftHint}">
                                    <arc:Badge.Icon>
                                        <lucide:LucideIcon Kind="Plus" Size="12" />
                                    </arc:Badge.Icon>
                                </arc:Badge>
                                <arc:Alert Tone="Danger" IsVisible="{Binding HasErrors}">
                                    <ItemsControl ItemsSource="{Binding Errors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:Alert>

                                <!-- 连接 -->
                                <Border Classes="card" Padding="16,14">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="sectionTitle" Text="{loc:TKCodeLangResource ConnectionLabel}" />
                                        <Grid ColumnDefinitions="100,*" IsVisible="{Binding IsCustom}">
                                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource ProtocolLabel}" VerticalAlignment="Center" />
                                            <arc:SegmentedControl Grid.Column="1" ItemsSource="{Binding ProtocolChoices}"
                                                                  controls:ChoiceSelection.Command="{Binding ChooseProtocolCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource BaseUrlLabel}" VerticalAlignment="Center" />
                                            <arc:Input Grid.Column="1" Text="{Binding BaseUrlInput, Mode=TwoWay}" FontFamily="{StaticResource TKCode.MonoFont}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100,*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource ApiKeyLabel}" VerticalAlignment="Center" />
                                            <arc:PasswordField Grid.Column="1" Label="{loc:TKCodeLangResource ApiKeyLabel}" IsLabelVisible="False"
                                                               Placeholder="{Binding KeyPlaceholder}" Text="{Binding KeyInput, Mode=TwoWay}"
                                                               IsRevealed="{Binding IsKeyRevealed, Mode=TwoWay}"
                                                               ShowPasswordText="{loc:TKCodeLangResource ShowKey}" HidePasswordText="{loc:TKCodeLangResource HideKey}" />
                                            <arc:Button Grid.Column="2" Margin="6,0,0,0" Variant="Ghost" Size="Small" VerticalAlignment="Center"
                                                        Command="{Binding ClearKeyCommand}" IsVisible="{Binding HasSavedKey}"
                                                        Content="{loc:TKCodeLangResource ClearKey}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="tertiary" Text="{Binding KeyHint}" Margin="2,6,0,0"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource TKCode.Divider}" Margin="-16,2" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <arc:Button Variant="Secondary" Size="Small" Command="{Binding TestCommand}" IsLoading="{Binding IsTesting}"
                                                        Content="{loc:TKCodeLangResource TestConnection}" />
                                            <Panel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" IsVisible="{Binding HasTestResult}">
                                                <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="{DynamicResource TKCode.Success}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding TestSucceeded}" arc:Tooltip.Tip="{Binding TestResult}" />
                                                <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !TestSucceeded}" arc:Tooltip.Tip="{Binding TestResult}" />
                                            </Panel>
                                            <TextBlock Grid.Column="2" Classes="tertiary" Text="{loc:TKCodeLangResource Unsaved}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsDirty}" />
                                            <Panel Grid.Column="3">
                                                <arc:Button Variant="Primary" Size="Small" Command="{Binding SaveCommand}"
                                                            Content="{loc:TKCodeLangResource Save}" IsVisible="{Binding !IsDraft}" />
                                                <arc:Button Variant="Primary" Size="Small" Command="{Binding SaveCommand}"
                                                            Content="{loc:TKCodeLangResource AddThisProvider}" IsVisible="{Binding IsDraft}" />
                                            </Panel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 模型 -->
                                <Border Classes="card" Padding="16,14">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,Auto,*,200,Auto">
                                            <TextBlock Classes="sectionTitle" Text="{loc:TKCodeLangResource ModelsLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="tertiary" Text="{Binding ModelsSummary}" Margin="10,0" VerticalAlignment="Center" />
                                            <arc:SearchField Grid.Column="3" Size="Small" IsVisible="{Binding HasModels}"
                                                             Label="{loc:TKCodeLangResource SearchModelsInProvider}" IsLabelVisible="False"
                                                             Placeholder="{loc:TKCodeLangResource SearchModelsInProvider}" ClearText="{loc:TKCodeLangResource ClearSearch}"
                                                             Text="{Binding ModelFilter, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <arc:Button Variant="Ghost" Size="Small" Command="{Binding EnableAllCommand}" IsVisible="{Binding HasModels}"
                                                            Content="{loc:TKCodeLangResource EnableAll}" />
                                                <arc:Button Variant="Ghost" Size="Small" Command="{Binding DisableAllCommand}" IsVisible="{Binding HasModels}"
                                                            Content="{loc:TKCodeLangResource DisableAll}" />
                                                <arc:Button Variant="Ghost" Size="Small" Command="{Binding RefreshModelsCommand}" IsLoading="{Binding IsRefreshing}"
                                                            IsVisible="{Binding SupportsDiscovery}" arc:Tooltip.Tip="{loc:TKCodeLangResource RefreshModels}"
                                                            AutomationProperties.Name="{loc:TKCodeLangResource RefreshModels}">
                                                    <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                        <arc:Alert Tone="Warning" Content="{Binding DiscoveryError}" IsVisible="{Binding HasDiscoveryError}" />
                                        <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource ModelsAfterKey}" FontSize="12" IsVisible="{Binding ShowModelsPlaceholder}" />

                                        <!-- 覆盖值编辑 -->
                                        <Border Classes="card" Padding="14,12" BorderBrush="{DynamicResource TKCode.Accent}"
                                                IsVisible="{Binding Editing, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Spacing="10" DataContext="{Binding Editing}" x:DataType="vm:ModelOverrideEditorViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="strong" Text="{loc:TKCodeLangResource EditModel}" />
                                                    <TextBlock Classes="tertiary" Text="{Binding ModelId}" FontFamily="{StaticResource TKCode.MonoFont}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,6,Auto">
                                                    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Classes="secondary" Text="{loc:TKCodeLangResource ProtocolLabel}" />
                                                    <arc:SegmentedControl Grid.Row="10" Grid.ColumnSpan="2" ItemsSource="{Binding ApiChoices}"
                                                                          controls:ChoiceSelection.Command="{Binding ChooseApiCommand}" />
                                                    <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource DisplayNameField}" VerticalAlignment="Center" />
                                                    <arc:Input Grid.Column="1" Size="Small" Text="{Binding NameInput, Mode=TwoWay}" Placeholder="{Binding ModelId}" />
                                                    <TextBlock Grid.Row="2" Classes="secondary" Text="{loc:TKCodeLangResource ContextWindowField}" VerticalAlignment="Center" />
                                                    <arc:Input Grid.Row="2" Grid.Column="1" Size="Small" Text="{Binding ContextInput, Mode=TwoWay}" />
                                                    <TextBlock Grid.Row="4" Classes="secondary" Text="{loc:TKCodeLangResource MaxTokensField}" VerticalAlignment="Center" />
                                                    <arc:Input Grid.Row="4" Grid.Column="1" Size="Small" Text="{Binding MaxTokensInput, Mode=TwoWay}" />
                                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                                        <arc:Checkbox IsChecked="{Binding Reasoning, Mode=TwoWay}" Content="{loc:TKCodeLangResource ReasoningTip}" />
                                                        <arc:Checkbox IsChecked="{Binding Images, Mode=TwoWay}" Content="{loc:TKCodeLangResource VisionTip}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Classes="tertiary" Text="{Binding Hint}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <arc:Button Variant="Ghost" Size="Small" Command="{Binding ResetCommand}"
                                                                Content="{loc:TKCodeLangResource ResetOverride}" />
                                                    <arc:Button Variant="Ghost" Size="Small"
                                                                Command="{Binding $parent[ContentControl].((vm:ProviderDetailViewModel)DataContext).CloseEditorCommand}"
                                                                Content="{loc:TKCodeLangResource Cancel}" />
                                                    <arc:Button Variant="Primary" Size="Small" Command="{Binding SaveCommand}"
                                                                Content="{loc:TKCodeLangResource Save}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding VisibleModels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProviderModelItemViewModel">
                                                    <Border BorderBrush="{DynamicResource TKCode.Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,56,84,96,Auto">
                                                            <arc:Switch VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                               Command="{Binding $parent[ItemsControl].((vm:ProviderDetailViewModel)DataContext).ToggleModelCommand}"
                                                                               CommandParameter="{Binding}" />
                                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Classes="strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TKCode.Accent}" VerticalAlignment="Center"
                                                                             IsVisible="{Binding HasOverride}" />
                                                                    <Border Background="{DynamicResource TKCode.AccentSoftBg}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                                                            IsVisible="{Binding ApiOverridden}" arc:Tooltip.Tip="{loc:TKCodeLangResource ModelProtocolTip}">
                                                                        <TextBlock Text="{Binding ApiText}" FontSize="10" Foreground="{DynamicResource TKCode.AccentText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TKCode.MonoFont}" TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding ShowId}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <icons:LucideIcon Kind="Brain" Width="13" Height="13" IsVisible="{Binding Reasoning}" arc:Tooltip.Tip="{loc:TKCodeLangResource ReasoningTip}"
                                                                                  StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                                <icons:LucideIcon Kind="Image" Width="13" Height="13" IsVisible="{Binding Images}" arc:Tooltip.Tip="{loc:TKCodeLangResource VisionTip}"
                                                                                  StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                                <icons:LucideIcon Kind="Zap" Width="13" Height="13" IsVisible="{Binding FastMode}" arc:Tooltip.Tip="{loc:TKCodeLangResource FastTip}"
                                                                                  StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                                <icons:LucideIcon Kind="Box" Width="12" Height="12" IsVisible="{Binding !InCatalog}" arc:Tooltip.Tip="{loc:TKCodeLangResource CustomModelTip}"
                                                                                  StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding ContextText}" FontSize="12" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="4" Classes="tertiary" Text="{Binding OutputText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="5" Classes="tertiary" Text="{Binding PriceText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                       arc:Tooltip.Tip="{loc:TKCodeLangResource PriceTip}" />
                                                            <arc:Button Grid.Column="6" Margin="6,0,0,0" Variant="Ghost" Size="Small"
                                                                        Command="{Binding $parent[ItemsControl].((vm:ProviderDetailViewModel)DataContext).EditModelCommand}"
                                                                        CommandParameter="{Binding}" arc:Tooltip.Tip="{loc:TKCodeLangResource EditModel}"
                                                                        AutomationProperties.Name="{loc:TKCodeLangResource EditModel}">
                                                                <lucide:LucideIcon Kind="Pencil" Size="14" />
                                                            </arc:Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <arc:Input Size="Small" Placeholder="{loc:TKCodeLangResource AddModelPlaceholder}" Text="{Binding NewModelId, Mode=TwoWay}"
                                                           FontFamily="{StaticResource TKCode.MonoFont}" />
                                            <arc:Button Grid.Column="1" Margin="8,0,0,0" Variant="Secondary" Size="Small" VerticalAlignment="Center"
                                                        Command="{Binding AddModelCommand}" Content="{loc:TKCodeLangResource AddModel}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </arc:ScrollArea>
    </Grid>
</UserControl>
