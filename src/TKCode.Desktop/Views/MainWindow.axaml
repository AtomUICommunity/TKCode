<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:motion="using:TKCode.Desktop.Motion"
        xmlns:sm="using:StreamMark.Avalonia.Transcript"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:views="using:TKCode.Desktop.Views"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.MainWindow"
        xmlns:composer="using:TKCode.Desktop.Controls.Composer"
             x:DataType="vm:MainWindowViewModel"
             Title="TKCode"
             Icon="avares://TKCode/Assets/app-logo.png"
             Width="1280" Height="800" MinWidth="880" MinHeight="560"
             IsTitleBarVisible="False"
             Background="{DynamicResource TKCode.WindowBg}"
             Foreground="{DynamicResource TKCode.TextPrimary}">
    <!-- 界面缩放：整个窗口内容等比缩放（弹层各自包一层 ZoomHost） -->
    <controls:ZoomHost>
    <Grid>
        <!-- 主区背景光晕（铺满整个窗口，侧栏在其上方叠加自己的底色） -->
        <Border Background="{DynamicResource TKCode.GlowMain}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource TKCode.GlowAccent}" IsHitTestVisible="False" />

        <Grid x:Name="AppPage" ColumnDefinitions="Auto,*" motion:Presence.IsPresent="{Binding !IsSettingsOpen}">
            <!-- ============ 侧栏：项目筛选 + 会话列表 ============ -->
            <!-- 侧栏开合：宽度动画，内容固定 256 宽、随边缘滑入滑出 -->
            <motion:Reveal x:Name="SidebarReveal" Grid.Column="0" Orientation="Horizontal" IsOpen="{Binding IsSidebarOpen}" Offset="-256" Fade="False">
            <Border Width="256"
                    Background="{DynamicResource TKCode.SidebarBg}"
                    BorderBrush="{DynamicResource TKCode.Divider}" BorderThickness="0,0,1,0">
                <Panel>
                    <Border Background="{DynamicResource TKCode.GlowSidebar}" IsHitTestVisible="False" />
                    <DockPanel>
                        <Panel DockPanel.Dock="Top" Height="44" Background="Transparent"
                               WindowDecorationProperties.ElementRole="TitleBar">
                            <StackPanel x:Name="SidebarHeader" Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding ToggleSidebarCommand}"
                                            WindowDecorationProperties.ElementRole="User" arc:Tooltip.Tip="{loc:TKCodeLangResource ToggleSidebar}" AutomationProperties.Name="{loc:TKCodeLangResource ToggleSidebar}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="PanelLeft" />
                                </arc:Button>
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding Conversation.GoBackCommand}"
                                            WindowDecorationProperties.ElementRole="User" arc:Tooltip.Tip="{loc:TKCodeLangResource Back}" AutomationProperties.Name="{loc:TKCodeLangResource Back}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="ArrowLeft" />
                                </arc:Button>
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding Conversation.GoForwardCommand}"
                                            WindowDecorationProperties.ElementRole="User" arc:Tooltip.Tip="{loc:TKCodeLangResource Forward}" AutomationProperties.Name="{loc:TKCodeLangResource Forward}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="ArrowRight" />
                                </arc:Button>
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding Sidebar.NewSessionCommand}"
                                            WindowDecorationProperties.ElementRole="User" arc:Tooltip.Tip="{loc:TKCodeLangResource NewSession}" AutomationProperties.Name="{loc:TKCodeLangResource NewSession}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="Plus" />
                                </arc:Button>
                            </StackPanel>
                        </Panel>

                        <!-- 项目列表（docs/design/projects.md §8）：点击项目按它筛选下面的会话，再次点击取消筛选 -->
                        <StackPanel x:Name="ProjectsSection" DockPanel.Dock="Top" Margin="8,4,8,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Theme="{StaticResource TKCode.RowButton}" MinHeight="28" Padding="8,0" Command="{Binding Sidebar.ToggleProjectsCommand}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="section" Text="{loc:TKCodeLangResource ProjectsSection}" VerticalAlignment="Center" />
                                        <icons:LucideIcon Grid.Column="1" Kind="ChevronDown" Width="12" Height="12" Margin="4,0,0,0" HorizontalAlignment="Left"
                                                          motion:Turn.IsOn="{Binding !Sidebar.IsProjectsExpanded}" motion:Turn.Angle="-90"
                                                          StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                    </Grid>
                                </Button>
                                <Button x:Name="CreateProjectButton" Grid.Column="1" Theme="{StaticResource TKCode.RowButton}" Width="24" MinHeight="24" Padding="0"
                                        Margin="2,0,0,0" HorizontalContentAlignment="Center" Command="{Binding Sidebar.CreateProjectCommand}"
                                        arc:Tooltip.Tip="{loc:TKCodeLangResource CreateProject}"
                                        AutomationProperties.Name="{loc:TKCodeLangResource CreateProject}">
                                    <icons:LucideIcon Kind="Plus" Width="14" Height="14" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                </Button>
                            </Grid>
                            <motion:Reveal IsOpen="{Binding Sidebar.IsProjectsExpanded}" Offset="-10">
                                <StackPanel>
                                    <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource NoProjects}" FontSize="12" Margin="8,4,0,4"
                                               IsVisible="{Binding Sidebar.HasNoProjects}" />
                                    <arc:ScrollArea MaxHeight="330">
                                        <ItemsControl x:Name="ProjectList" ItemsSource="{Binding Sidebar.VisibleProjects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProjectRowViewModel">
                                                    <Grid Classes="projectRow" Classes.menuOpen="{Binding #RowMenu.IsOpen}" Margin="0,0,0,1" Background="Transparent"
                                                          arc:Tooltip.Tip="{Binding FoldersTip}">
                                                        <arc:ContextMenu OpensOnClick="False">
                                                            <arc:ContextMenu.Items>
                                                                <arc:MenuEntry Header="{loc:TKCodeLangResource EditProjectMenu}" Icon="{lucide:LucideGeometry Kind=Pencil}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.EditProjectCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RevealProjectText}"
                                                                               Icon="{lucide:LucideGeometry Kind=FolderOpen}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.RevealProjectCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{loc:TKCodeLangResource CopyPath}" Icon="{lucide:LucideGeometry Kind=Copy}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.CopyProjectPathCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{Binding PinText}" Icon="{lucide:LucideGeometry Kind=Pin}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.TogglePinCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{loc:TKCodeLangResource ProjectRemove}" Icon="{lucide:LucideGeometry Kind=Trash2}"
                                                                               IsDestructive="True" HasSeparatorBefore="True"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.RequestRemoveProjectCommand}"
                                                                               CommandParameter="{Binding}" />
                                                            </arc:ContextMenu.Items>
                                                            <Button Classes="projectRowButton" Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}"
                                                                    MinHeight="30" Padding="8,0"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.SelectProjectCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <icons:LucideIcon Kind="Folder" Width="14" Height="14" VerticalAlignment="Center"
                                                                                      StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                                    <TextBlock Classes="projectName" Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                                               TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                                                    <StackPanel Classes="projectMarks" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0"
                                                                                VerticalAlignment="Center">
                                                                        <controls:DotSpinner Width="9" Height="9" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                                                                        <icons:LucideIcon Kind="CircleAlert" Width="12" Height="12" IsVisible="{Binding IsMissing}"
                                                                                          StrokeBrush="{DynamicResource TKCode.GitModified}" />
                                                                        <icons:LucideIcon Kind="Pin" Width="11" Height="11" IsVisible="{Binding IsPinned}"
                                                                                          StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </arc:ContextMenu>
                                                        <!-- 悬停或菜单打开时显示：更多操作、在此项目中新建会话 -->
                                                        <StackPanel Classes="rowActions" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <arc:DropdownMenu x:Name="RowMenu" Side="Bottom" Alignment="End">
                                                                <arc:DropdownMenu.Trigger>
                                                                    <Button Theme="{StaticResource TKCode.RowButton}" Width="22" MinHeight="22" Height="22" Padding="0"
                                                                            HorizontalContentAlignment="Center"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0} …}">
                                                                        <icons:LucideIcon Kind="Ellipsis" Width="14" Height="14" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                                    </Button>
                                                                </arc:DropdownMenu.Trigger>
                                                                <arc:MenuEntry Header="{loc:TKCodeLangResource EditProjectMenu}" Icon="{lucide:LucideGeometry Kind=Pencil}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.EditProjectCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RevealProjectText}"
                                                                               Icon="{lucide:LucideGeometry Kind=FolderOpen}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.RevealProjectCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{loc:TKCodeLangResource CopyPath}" Icon="{lucide:LucideGeometry Kind=Copy}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.CopyProjectPathCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{Binding PinText}" Icon="{lucide:LucideGeometry Kind=Pin}"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.TogglePinCommand}"
                                                                               CommandParameter="{Binding}" />
                                                                <arc:MenuEntry Header="{loc:TKCodeLangResource ProjectRemove}" Icon="{lucide:LucideGeometry Kind=Trash2}"
                                                                               IsDestructive="True" HasSeparatorBefore="True"
                                                                               Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.RequestRemoveProjectCommand}"
                                                                               CommandParameter="{Binding}" />
                                                            </arc:DropdownMenu>
                                                            <Button Theme="{StaticResource TKCode.RowButton}" Width="22" MinHeight="22" Height="22" Padding="0"
                                                                    HorizontalContentAlignment="Center" IsEnabled="{Binding !IsMissing}"
                                                                    arc:Tooltip.Tip="{Binding NewSessionTip}" AutomationProperties.Name="{Binding NewSessionTip}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.NewSessionInProjectCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <icons:LucideIcon Kind="SquarePen" Width="13" Height="13" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                    <Button x:Name="ProjectsMore" Theme="{StaticResource TKCode.RowButton}" MinHeight="26" Margin="0,1,0,0"
                                            Command="{Binding Sidebar.ToggleShowAllProjectsCommand}" IsVisible="{Binding Sidebar.HasMoreProjects}">
                                        <TextBlock Classes="tertiary" FontSize="12" Margin="22,0,0,0" Text="{Binding Sidebar.MoreProjectsText}" />
                                    </Button>
                                </StackPanel>
                            </motion:Reveal>
                        </StackPanel>

                        <!-- 底部：用户、语言、主题、设置 -->
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,6,8,12">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource TKCode.TextPrimary}"
                                    ToolTip.Tip="{Binding Sidebar.UserName}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Sidebar.UserInitial}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TKCode.WindowBg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <arc:Button Classes="icon" Variant="Ghost" Grid.Column="2" Size="Small"
                                        Command="{Binding ToggleLanguageCommand}" arc:Tooltip.Tip="{loc:TKCodeLangResource SwitchLanguage}" AutomationProperties.Name="{loc:TKCodeLangResource SwitchLanguage}">
                                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="Languages" />
                            </arc:Button>
                            <arc:Button Classes="icon" Variant="Ghost" Grid.Column="3" Size="Small"
                                        Command="{Binding ToggleThemeCommand}" arc:Tooltip.Tip="{loc:TKCodeLangResource ToggleTheme}" AutomationProperties.Name="{loc:TKCodeLangResource ToggleTheme}">
                                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="{Binding Themes.IsDark, Converter={x:Static views:Converters.ThemeIcon}}" />
                            </arc:Button>
                            <Panel Grid.Column="4">
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding OpenSettingsCommand}"
                                            arc:Tooltip.Tip="{loc:TKCodeLangResource OpenSettings}" AutomationProperties.Name="{loc:TKCodeLangResource OpenSettings}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="Settings" />
                                </arc:Button>
                                <!-- 有可用更新：关闭提醒卡片后仍能从这里进入设置 › 关于 -->
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource TKCode.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,3,3,0" IsHitTestVisible="False" IsVisible="{Binding Updates.HasUpdate}"
                                         ToolTip.Tip="{loc:TKCodeLangResource UpdateBadgeTip}" />
                            </Panel>
                        </Grid>

                        <!-- 会话列表：标题行固定，列表虚拟化（只创建可见行），底部“展开更多”分页 -->
                        <DockPanel Margin="8,6,8,8">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource NoSessions}" FontSize="12" Margin="8,8,0,0"
                                           IsVisible="{Binding Sidebar.HasNoSessions}" />
                                <!-- 会话区标题：筛选中为「会话 · 项目名」，✕ 清除筛选 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,2">
                                    <Button Theme="{StaticResource TKCode.RowButton}" MinHeight="28" Padding="8,0" Command="{Binding Sidebar.ToggleSessionsCommand}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock x:Name="SessionsTitle" Classes="section" Text="{Binding Sidebar.SessionsTitle}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <icons:LucideIcon Grid.Column="1" Kind="ChevronDown" Width="12" Height="12" Margin="4,0,0,0" HorizontalAlignment="Left"
                                                              motion:Turn.IsOn="{Binding !Sidebar.IsSessionsExpanded}" motion:Turn.Angle="-90"
                                                              StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ClearProjectFilterButton" Grid.Column="1" Theme="{StaticResource TKCode.RowButton}" Width="24" MinHeight="24" Padding="0"
                                            Margin="2,0,0,0" HorizontalContentAlignment="Center" IsVisible="{Binding Sidebar.IsFiltered}"
                                            Command="{Binding Sidebar.ClearFilterCommand}" arc:Tooltip.Tip="{loc:TKCodeLangResource ClearProjectFilter}"
                                            AutomationProperties.Name="{loc:TKCodeLangResource ClearProjectFilter}">
                                        <icons:LucideIcon Kind="X" Width="13" Height="13" StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <motion:Reveal IsOpen="{Binding Sidebar.IsSessionsExpanded}" Offset="-10">
                            <!-- 分页：默认显示 20 条；Host 多返回一条说明还有下一页，列表底部固定显示“展开更多”。 -->
                            <DockPanel>
                            <Button DockPanel.Dock="Bottom" x:Name="SessionLoadMore" Theme="{StaticResource TKCode.RowButton}"
                                    MinHeight="28" Margin="0,4,0,0" Command="{Binding Conversation.LoadMoreSessionsCommand}"
                                    IsVisible="{Binding Conversation.HasMoreSessions}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <icons:LucideIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center"
                                                      StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                    <TextBlock Classes="tertiary" FontSize="12" VerticalAlignment="Center"
                                               Text="{loc:TKCodeLangResource SessionsLoadMore}" />
                                </StackPanel>
                            </Button>
                            <ItemsControl x:Name="SessionList" ItemsSource="{Binding Sidebar.VisibleSessions}" motion:ItemsMotion.Enter="SlideDown">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <arc:ScrollArea>
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </arc:ScrollArea>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                                        <arc:ContextMenu OpensOnClick="False">
                                            <arc:ContextMenu.Items>
                                                <arc:MenuEntry Header="{loc:TKCodeLangResource SessionRename}" Icon="{lucide:LucideGeometry Kind=Pencil}"
                                                               Command="{Binding BeginRenameCommand}" />
                                                <arc:MenuEntry Header="{Binding PinMenuText}" Icon="{lucide:LucideGeometry Kind=Pin}"
                                                               Command="{Binding TogglePinCommand}" />
                                                <arc:MenuEntry Header="{loc:TKCodeLangResource SessionFork}" Icon="{lucide:LucideGeometry Kind=GitBranch}" IsEnabled="{Binding CanFork}"
                                                               Command="{Binding ForkCommand}" />
                                                <arc:MenuEntry Header="{Binding RevealMenuText}" Icon="{lucide:LucideGeometry Kind=Folder}" HasSeparatorBefore="True"
                                                               Command="{Binding RevealCommand}" />
                                                <arc:MenuEntry Header="{loc:TKCodeLangResource SessionCopyId}" Icon="{lucide:LucideGeometry Kind=Copy}"
                                                               Command="{Binding CopyIdCommand}" />
                                                <arc:MenuEntry Header="{loc:TKCodeLangResource SessionDelete}" Icon="{lucide:LucideGeometry Kind=Trash2}" IsDestructive="True" HasSeparatorBefore="True"
                                                               Command="{Binding DeleteCommand}" />
                                            </arc:ContextMenu.Items>
                                            <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="30" Margin="0,0,0,1"
                                                    Padding="6,0,8,0" ToolTip.Tip="{Binding DisplayTitle}" DoubleTapped="OnSessionDoubleTapped"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Conversation.OpenSessionCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="12,Auto,Auto,*,Auto">
                                                    <Panel VerticalAlignment="Center">
                                                        <controls:DotSpinner Width="9" Height="9" IsVisible="{Binding ShowSpinner}" HorizontalAlignment="Center" />
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TKCode.TextTertiary}" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding ShowIdleDot}" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TKCode.GitModified}" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding IsWaitingApproval}" ToolTip.Tip="{loc:TKCodeLangResource SessionWaitingForYou}" />
                                                    </Panel>
                                                    <Panel Grid.Column="1" Width="14" Height="14" Margin="4,0,6,0" VerticalAlignment="Center">
                                                        <icons:ProviderLogo Key="{Binding ModelIconKey}" Width="14" Height="14" />
                                                        <!-- 外部运行时：右下角叠加运行时小图标 -->
                                                        <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource TKCode.SidebarBg}" IsVisible="{Binding HasRuntime}" ToolTip.Tip="{Binding RuntimeTip}">
                                                            <icons:ProviderLogo Key="{Binding RuntimeIconKey}" Width="8" Height="8" />
                                                        </Border>
                                                    </Panel>
                                                    <!-- 项目徽标：只在「全部会话」里显示，筛选中多余 -->
                                                    <Border Grid.Column="2" Width="14" Height="14" CornerRadius="3" Background="{DynamicResource TKCode.BadgeBg}"
                                                            ToolTip.Tip="{Binding ProjectName}" VerticalAlignment="Center" Margin="0,0,7,0">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="HasProject" />
                                                                <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).Sidebar.ShowsProjectBadges" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <TextBlock Text="{Binding ProjectInitial}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TKCode.BadgeFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Classes="strong" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                               VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}" />
                                                    <!-- 行内重命名：Enter 保存，Esc 取消，失去焦点保存 -->
                                                    <arc:Input Grid.Column="3" Grid.ColumnSpan="2" Size="Small" IsVisible="{Binding IsRenaming}"
                                                                   Text="{Binding EditTitle, Mode=TwoWay}" VerticalAlignment="Center"
                                                                   controls:InlineEdit.CommitCommand="{Binding CommitRenameCommand}"
                                                                   controls:InlineEdit.CancelCommand="{Binding CancelRenameCommand}" />
                                                    <Panel Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}">
                                                        <TextBlock Classes="tertiary" Text="{Binding RelativeTime}" FontSize="11" IsVisible="{Binding !IsPinned}" />
                                                        <icons:LucideIcon Kind="Pin" Width="11" Height="11" IsVisible="{Binding IsPinned}"
                                                                          StrokeBrush="{DynamicResource TKCode.TextTertiary}" ToolTip.Tip="{loc:TKCodeLangResource SessionPinned}" />
                                                    </Panel>
                                                </Grid>
                                            </Button>
                                        </arc:ContextMenu>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </DockPanel>
                            </motion:Reveal>
                        </DockPanel>
                    </DockPanel>
                </Panel>
            </Border>
            </motion:Reveal>

            <!-- ============ 主区域：对话 | 分割条 | 编辑区 | 分割条 | 文件树 ============ -->
            <Grid x:Name="MainGrid" Grid.Column="1" ColumnDefinitions="*,Auto,0,Auto,0">
                <DockPanel x:Name="ConversationColumn" Grid.Column="0" ClipToBounds="True">
                    <Panel x:Name="ConversationHeader" DockPanel.Dock="Top" Height="44" Background="Transparent"
                           WindowDecorationProperties.ElementRole="TitleBar">
                        <StackPanel x:Name="MainHeaderLeft" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="2" motion:Presence.IsPresent="{Binding !IsSidebarOpen}" motion:Presence.Effect="Fade"
                                        motion:Presence.AnimateExit="False">
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding ToggleSidebarCommand}"
                                            WindowDecorationProperties.ElementRole="User" arc:Tooltip.Tip="{loc:TKCodeLangResource ToggleSidebar}" AutomationProperties.Name="{loc:TKCodeLangResource ToggleSidebar}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="PanelLeft" />
                                </arc:Button>
                                <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding Sidebar.NewSessionCommand}"
                                            WindowDecorationProperties.ElementRole="User" arc:Tooltip.Tip="{loc:TKCodeLangResource NewSession}" AutomationProperties.Name="{loc:TKCodeLangResource NewSession}">
                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="Plus" />
                                </arc:Button>
                            </StackPanel>
                            <!-- 会话标题：模型图标 + 标题 + 项目 @ 设备 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0"
                                        motion:Presence.IsPresent="{Binding !Conversation.IsEmpty}" motion:Presence.Effect="SlideRight">
                                <icons:ProviderLogo Key="{Binding Conversation.HeaderIconKey}" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Classes="strong" Text="{Binding Conversation.HeaderTitle}" MaxWidth="360" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           VerticalAlignment="Center" />
                                <TextBlock Classes="secondary" Text="{Binding Conversation.HeaderSubtitle}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            </StackPanel>
                        </StackPanel>
                    </Panel>

                    <Panel>
                        <!-- 空状态：居中的 Composer，上方是设备 / 项目，下方是检出 / 分支 -->
                        <StackPanel MaxWidth="620" Margin="32,0,32,72" Spacing="8" VerticalAlignment="Center"
                                    motion:Presence.IsPresent="{Binding Conversation.IsEmpty}" motion:Presence.Effect="Zoom" motion:Presence.Distance="-8">
                            <TextBlock x:Name="WelcomeQuip" Text="{Binding Conversation.WelcomeQuip}"
                                       Classes="secondary" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,0,0,24" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button Theme="{StaticResource TKCode.ChipButton}" ToolTip.Tip="{loc:TKCodeLangResource Online}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:LucideIcon Kind="Monitor" Width="12" Height="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Conversation.DeviceName}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <icons:LucideIcon Kind="ChevronDown" Width="11" Height="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <views:ProjectPickerView DataContext="{Binding Sidebar.WorkspacePicker}" />
                            </StackPanel>

                            <views:ComposerView x:Name="EmptyComposer" DataContext="{Binding Conversation}" />

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Theme="{StaticResource TKCode.ChipButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:LucideIcon Kind="Folder" Width="12" Height="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:TKCodeLangResource CurrentCheckout}" FontSize="12" VerticalAlignment="Center" />
                                        <icons:LucideIcon Kind="ChevronDown" Width="11" Height="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <views:BranchPickerView DataContext="{Binding Conversation.BranchPicker}" />
                                <!-- 权限档位（询问 / 自动放行 / 完全授权） -->
                                <views:PermissionPickerView DataContext="{Binding Conversation.Permission}" Margin="4,0,0,0" />
                                <!-- 模式（Agent / Ask / Plan / 自定义 role） -->
                                <views:RolePickerView x:Name="EmptyRolePicker" DataContext="{Binding Conversation.RolePicker}" Margin="2,0,0,0" />
                            </StackPanel>

                            <motion:Reveal IsOpen="{Binding Conversation.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="secondary" Text="{Binding Conversation.StatusMessage}" TextWrapping="Wrap" Margin="8,4,0,0" />
                            </motion:Reveal>
                        </StackPanel>

                        <!-- 会话转录 -->
                        <DockPanel motion:Presence.IsPresent="{Binding !Conversation.IsEmpty}" motion:Presence.Effect="Fade">
                            <StackPanel DockPanel.Dock="Bottom" Margin="32,6,32,14" MaxWidth="760" Spacing="6">
                                <!-- 运行中发送的消息：排队，可编辑、移除或立即插入当前轮 -->
                                <!-- 卡片出现 / 消失时高度平滑过渡，输入框被顺滑地推上去 -->
                                <motion:Reveal IsOpen="{Binding Conversation.Active.HasQueuedPrompts, FallbackValue=False}" Offset="10">
                                <Border Classes="card" Padding="10,8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,2">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Classes="secondary" FontSize="12" Text="{Binding Conversation.Active.QueueTitle, FallbackValue={x:Null}}" />
                                                <TextBlock Classes="tertiary" FontSize="12" Text="{loc:TKCodeLangResource QueuePaused}"
                                                           IsVisible="{Binding Conversation.Active.IsQueuePaused, FallbackValue=False}" />
                                            </StackPanel>
                                            <arc:Button Variant="Ghost" Grid.Column="1" Size="Small" Command="{Binding Conversation.ResumeQueueCommand}"
                                                        IsVisible="{Binding Conversation.Active.IsQueuePaused, FallbackValue=False}"
                                                        Content="{loc:TKCodeLangResource QueueResume}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Conversation.Active.QueuedPrompts, FallbackValue={x:Null}}" motion:ItemsMotion.Enter="SlideUp">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QueuedPromptViewModel">
                                                    <!-- 长消息收起到 2 行（Arc ExpandableText），图标和按钮对齐第一行 -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="30">
                                                        <icons:LucideIcon Kind="CornerDownLeft" Width="12" Height="12" Margin="4,9,8,0" VerticalAlignment="Top"
                                                                          StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                                                        <arc:ExpandableText Grid.Column="1" Text="{Binding DisplayText}" Lines="2" Margin="0,5" VerticalAlignment="Top"
                                                                            MoreLabel="{loc:TKCodeLangResource TextExpandMore}"
                                                                            LessLabel="{loc:TKCodeLangResource TextExpandLess}"
                                                                            IsVisible="{Binding !IsEditing}" />
                                                        <arc:Input Grid.Column="1" Grid.ColumnSpan="2" Size="Small" IsVisible="{Binding IsEditing}"
                                                                       Text="{Binding EditText, Mode=TwoWay}" VerticalAlignment="Center"
                                                                       controls:InlineEdit.CommitCommand="{Binding CommitEditCommand}"
                                                                       controls:InlineEdit.CancelCommand="{Binding CancelEditCommand}" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,3,0,0" VerticalAlignment="Top"
                                                                    IsVisible="{Binding !IsEditing}">
                                                            <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding BeginEditCommand}"
                                                                        arc:Tooltip.Tip="{loc:TKCodeLangResource QueueEdit}" AutomationProperties.Name="{loc:TKCodeLangResource QueueEdit}">
                                                                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="Pencil" />
                                                            </arc:Button>
                                                            <arc:Button Variant="Ghost" Size="Small" Command="{Binding SendNowCommand}"
                                                                        arc:Tooltip.Tip="{loc:TKCodeLangResource QueueSendNowTip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Kind="ArrowUp" Width="12" Height="12" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{loc:TKCodeLangResource QueueSendNow}" FontSize="12" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </arc:Button>
                                                            <arc:Button Classes="icon" Variant="Ghost" Size="Small" Command="{Binding RemoveCommand}"
                                                                        arc:Tooltip.Tip="{loc:TKCodeLangResource QueueRemove}" AutomationProperties.Name="{loc:TKCodeLangResource QueueRemove}">
                                                                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="X" />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                </motion:Reveal>
                                <!-- 等待批准的操作 -->
                                <motion:Reveal IsOpen="{Binding Conversation.Active.HasPendingApproval, FallbackValue=False}" Offset="12">
                                <Border Classes="card" Padding="14,12" BorderBrush="{DynamicResource TKCode.GitModified}">
                                    <StackPanel Spacing="8" DataContext="{Binding Conversation.Active.CurrentApproval, FallbackValue={x:Null}}"
                                                x:DataType="vm:ApprovalRequestViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <icons:LucideIcon Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Center"
                                                              StrokeBrush="{DynamicResource TKCode.GitModified}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Classes="strong" Text="{loc:TKCodeLangResource ApprovalTitle}" />
                                                <TextBlock Classes="secondary" Text="{Binding KindText}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="tertiary" VerticalAlignment="Center"
                                                       Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Conversation.Active.MoreApprovalsText, FallbackValue=''}"
                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Conversation.Active.HasMoreApprovals, FallbackValue=False}" />
                                        </Grid>
                                        <Border Background="{DynamicResource TKCode.CodeBg}" CornerRadius="6" Padding="10,6">
                                            <SelectableTextBlock Text="{Binding Title}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                        <SelectableTextBlock Text="{Binding Details}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="11" TextWrapping="Wrap"
                                                             MaxHeight="120" Foreground="{DynamicResource TKCode.TextSecondary}" IsVisible="{Binding HasDetails}" />
                                        <TextBlock Classes="secondary" Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <arc:Button Variant="Ghost" Size="Small" Command="{Binding DenyCommand}" Content="{loc:TKCodeLangResource Deny}" />
                                            <arc:Button Variant="Secondary" Size="Small" Command="{Binding AllowForSessionCommand}"
                                                        IsVisible="{Binding CanAllowForSession}" Content="{loc:TKCodeLangResource AllowForSession}" />
                                            <arc:Button Variant="Primary" Size="Small" Command="{Binding AllowOnceCommand}"
                                                        Content="{loc:TKCodeLangResource AllowOnce}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </motion:Reveal>
                                <!-- MCP 服务器请求用户输入 -->
                                <motion:Reveal IsOpen="{Binding Conversation.Active.HasPendingElicitation, FallbackValue=False}" Offset="12">
                                    <views:McpElicitationView DataContext="{Binding Conversation.Active.CurrentElicitation, FallbackValue={x:Null}}" />
                                </motion:Reveal>
                                <!-- Agent 提问：问答面板替换输入框，必须先回答或拒绝回答（docs/design/ask-user.md §7） -->
                                <views:QuestionPanelView x:Name="QuestionPanel" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Conversation.IsAnsweringQuestion, FallbackValue=False}"
                                                         DataContext="{Binding Conversation.Active.CurrentQuestion, FallbackValue={x:Null}}" />
                                <!-- 计划审批：审批面板替换输入框，批准、修改或退回（docs/design/plan-mode.md §14.1） -->
                                <views:PlanReviewPanelView x:Name="PlanReviewPanel" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Conversation.ShowPlanReview, FallbackValue=False}"
                                                           DataContext="{Binding Conversation.Active.CurrentPlanReview, FallbackValue={x:Null}}" />
                                <views:ComposerView x:Name="DockedComposer" Classes="compact" DataContext="{Binding Conversation}"
                                                    IsVisible="{Binding ShowDockedComposer}" />
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="6,0">
                                    <Button Theme="{StaticResource TKCode.ChipButton}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:LucideIcon Kind="Folder" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:TKCodeLangResource LocalCheckout}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <views:BranchPickerView Grid.Column="1" DataContext="{Binding Conversation.BranchPicker}" />
                                    <views:PermissionPickerView Grid.Column="2" DataContext="{Binding Conversation.Permission}" Margin="4,0,0,0" />
                                    <views:RolePickerView x:Name="DockedRolePicker" Grid.Column="3" DataContext="{Binding Conversation.RolePicker}" Margin="2,0,0,0" />
                                    <!-- 上下文占用：悬停弹出容量卡片（分类占比、平均缓存命中率，docs/design/context-usage.md） -->
                                    <controls:HoverCard x:Name="ContextUsageCard" Grid.Column="5" VerticalAlignment="Center" Placement="TopEdgeAlignedRight"
                                                        DataContext="{Binding Conversation.ContextUsage}" x:DataType="vm:ContextUsageViewModel"
                                                        IsVisible="{Binding HasUsage}" IsOpen="{Binding IsCardOpen}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                                            <Panel>
                                                <controls:ContextRing Width="14" Height="14" Value="{Binding Value}"
                                                                      TrackBrush="{DynamicResource TKCode.RingTrack}" Foreground="{DynamicResource TKCode.TextSecondary}"
                                                                      IsVisible="{Binding !IsNearlyFull}" />
                                                <!-- 接近自动压缩阈值：换成强调色 -->
                                                <controls:ContextRing Width="14" Height="14" Value="{Binding Value}"
                                                                      TrackBrush="{DynamicResource TKCode.RingTrack}" Foreground="{DynamicResource TKCode.FileOrange}"
                                                                      IsVisible="{Binding IsNearlyFull}" />
                                            </Panel>
                                            <TextBlock Classes="secondary" Text="{Binding PercentText}" FontSize="12" />
                                        </StackPanel>
                                        <controls:HoverCard.Card>
                                            <controls:InfoCard Width="300" Title="{loc:TKCodeLangResource ContextCardTitle}" Extra="{Binding Summary}">
                                                <StackPanel Spacing="14">
                                                    <controls:SegmentedBar Segments="{Binding Segments}" TrackBrush="{DynamicResource TKCode.RingTrack}" />
                                                    <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ContextCategoryItem">
                                                                <controls:CardStatRow Label="{Binding Label}" Value="{Binding Share}" MarkerKey="{Binding MarkerKey}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="tertiary" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsBreakdownUnavailable}"
                                                               Text="{loc:TKCodeLangResource ContextBreakdownUnavailable}" />
                                                </StackPanel>
                                                <controls:InfoCard.Footer>
                                                    <StackPanel Spacing="8">
                                                        <controls:CardStatRow Label="{loc:TKCodeLangResource ContextCacheAverage}" Value="{Binding CacheHitRate}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsNearlyFull}">
                                                            <icons:LucideIcon Kind="CircleAlert" Width="13" Height="13" VerticalAlignment="Center"
                                                                              StrokeBrush="{DynamicResource TKCode.FileOrange}" />
                                                            <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Text="{loc:TKCodeLangResource ContextNearlyFull}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </controls:InfoCard.Footer>
                                            </controls:InfoCard>
                                        </controls:HoverCard.Card>
                                    </controls:HoverCard>
                                </Grid>
                                <motion:Reveal IsOpen="{Binding Conversation.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Classes="secondary" Text="{Binding Conversation.StatusMessage}" TextWrapping="Wrap" Margin="8,0" />
                                </motion:Reveal>
                            </StackPanel>
                            <!-- 会话：StreamMark 虚拟化会话视图（正文块按顶层 Markdown 块虚拟化，可跨消息选择）；
                                 其余条目（用户消息、思考、工具调用、消息底栏、等待指示）使用 Views/TranscriptTemplates.axaml 的数据模板 -->
                            <Panel>
                            <sm:TranscriptView x:Name="Transcript" MaxContentWidth="760" Padding="32,8,32,16" EntrySpacing="12"
                                               atom:ScrollViewer.IsLiteMode="True" />
                            <!-- 任务球（右上角）：收起是一个球，展开是 Agent / Shell / 任务清单 / 更改 -->
                            <views:TaskOrbView x:Name="TaskOrb" DataContext="{Binding Conversation.Active, FallbackValue={x:Null}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,20,0" />
                            <!-- 向上滚动离开底部后浮出：↓ 回到底部 -->
                            <Button x:Name="ScrollToBottomButton" Theme="{StaticResource TKCode.PillButton}" motion:Presence.IsPresent="False"
                                    motion:Presence.Effect="SlideUp" motion:Presence.Distance="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="12,0" MinHeight="30"
                                    Background="{DynamicResource TKCode.PopupBg}" BorderBrush="{DynamicResource TKCode.PillBorder}" BorderThickness="1"
                                    CornerRadius="15" Click="OnScrollToBottomClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:LucideIcon Kind="ArrowDown" Width="13" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:TKCodeLangResource ScrollToBottom}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            </Panel>
                        </DockPanel>
                    </Panel>
                </DockPanel>

                <GridSplitter x:Name="WorkbenchSplitter" Grid.Column="1" Theme="{StaticResource TKCode.Splitter}"
                              ResizeDirection="Columns" IsVisible="False" />

                <!-- ============ 编辑区：标签页（文件 / 工具面板） ============ -->
                <!-- 显示与列宽由 MainWindow.UpdateColumns 控制（开合有宽度动画） -->
                <DockPanel x:Name="EditorColumn" Grid.Column="2" IsVisible="False" ClipToBounds="True">
                    <Grid x:Name="EditorHeader" DockPanel.Dock="Top" Height="44" Background="Transparent" ColumnDefinitions="*,Auto"
                          WindowDecorationProperties.ElementRole="TitleBar">
                        <!-- 标签栏占满剩余宽度：溢出时截断（可横向滚动），“+”紧跟在最后一个标签后 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="8,0,4,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                            <ItemsControl ItemsSource="{Binding Workbench.Tabs}" motion:ItemsMotion.Enter="Pop">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkbenchTabViewModel">
                                        <Button Theme="{StaticResource TKCode.TabButton}" Classes.active="{Binding IsActive}"
                                                WindowDecorationProperties.ElementRole="User"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workbench.ActivateCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:FileTypeIcon Kind="{Binding Icon}" ColorKey="{Binding IconColor}" Width="13" Height="13" VerticalAlignment="Center"
                                                                    IsVisible="{Binding !IsBusy}" />
                                                <controls:DotSpinner Width="11" Height="11" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                                                <Button Theme="{StaticResource TKCode.RowButton}" MinHeight="18" Width="18" Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workbench.CloseCommand}"
                                                        CommandParameter="{Binding}">
                                                    <icons:LucideIcon Kind="X" Width="11" Height="11" />
                                                </Button>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        <!-- “+”：添加工具面板 -->
                        <Panel VerticalAlignment="Center" Margin="2,0,0,0">
                            <Button x:Name="AddPanelButton" Theme="{StaticResource TKCode.RowButton}" Width="26" MinHeight="26" Padding="0"
                                    HorizontalContentAlignment="Center" Classes.selected="{Binding #AddPanelPopup.IsOpen}"
                                    WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{loc:TKCodeLangResource AddPanel}" Click="OnAddPanelClick">
                                <icons:LucideIcon Kind="Plus" Width="13" Height="13" />
                            </Button>
                            <motion:Popover x:Name="AddPanelPopup" PlacementTarget="{Binding #AddPanelButton}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                                   IsLightDismissEnabled="True">
                                <controls:ZoomHost>
                                <Border Classes="menu" Width="180" Margin="0,0,16,16">
                                    <ItemsControl ItemsSource="{Binding Workbench.Tools}" Margin="4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkbenchToolViewModel">
                                                <Button Theme="{StaticResource TKCode.MenuItem}" MinHeight="32" Click="OnAddPanelChosen"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workbench.AddToolCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <icons:LucideIcon Kind="{Binding Icon}" Width="14" Height="14" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                        <TextBlock Classes="strong" Text="{Binding Title}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                </controls:ZoomHost>
                            </motion:Popover>
                        </Panel>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- 最大化 / 还原（右侧为面板开关预留位置，见 MainWindow.UpdateHeaderInsets） -->
                        <Panel x:Name="EditorHeaderRight" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Theme="{StaticResource TKCode.RowButton}" Width="26" MinHeight="26" Padding="0" HorizontalContentAlignment="Center"
                                    Classes.selected="{Binding Workbench.IsMaximized}" IsVisible="{Binding Workbench.HasTabs}"
                                    WindowDecorationProperties.ElementRole="User" Command="{Binding Workbench.ToggleMaximizeCommand}"
                                    ToolTip.Tip="{loc:TKCodeLangResource MaximizeEditor}">
                                <Panel>
                                    <icons:LucideIcon Kind="Maximize2" Width="13" Height="13" IsVisible="{Binding !Workbench.IsMaximized}" />
                                    <icons:LucideIcon Kind="Minimize2" Width="13" Height="13" IsVisible="{Binding Workbench.IsMaximized}" />
                                </Panel>
                            </Button>
                        </Panel>
                    </Grid>

                    <Panel>
                        <!-- 没有标签页：提示 + 工具面板入口 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="280"
                                    IsVisible="{Binding !Workbench.HasTabs}">
                            <icons:LucideIcon Kind="FolderTree" Width="26" Height="26" HorizontalAlignment="Center"
                                              StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource WorkbenchEmpty}" TextWrapping="Wrap" TextAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Workbench.Tools}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkbenchToolViewModel">
                                        <Button Theme="{StaticResource TKCode.TileButton}" Width="120" Height="72" Margin="4"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workbench.AddToolCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <icons:LucideIcon Kind="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="12" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ContentControl x:Name="ActiveTabContent" Content="{Binding Workbench.ActiveTab}" IsVisible="{Binding Workbench.HasTabs}">
                            <ContentControl.DataTemplates>
                                <!-- 文件：面包屑 + 查看方式切换 + 预览器内容 -->
                                <DataTemplate DataType="vm:FileTabViewModel">
                                    <views:FileTabView />
                                </DataTemplate>
                                <!-- 终端：pty host 中的会话（06 §2） -->
                                <DataTemplate DataType="vm:TerminalTabViewModel">
                                    <views:TerminalTabView />
                                </DataTemplate>
                                <!-- 变更：当前会话的文件改动（左列表，右 diff） -->
                                <DataTemplate DataType="vm:ChangesTabViewModel">
                                    <views:ChangesTabView />
                                </DataTemplate>
                                <!-- 子 Agent：它的消息，与主会话同样的转录，没有输入框 -->
                                <DataTemplate DataType="vm:SubagentTabViewModel">
                                    <views:SubagentTabView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:PlaceholderTabViewModel">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Spacing="10">
                                        <icons:LucideIcon Kind="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" />
                                        <TextBlock Classes="title" Text="{Binding Title}" HorizontalAlignment="Center" />
                                        <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource ComingSoon}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Panel>
                </DockPanel>

                <controls:PanelSplitter x:Name="ExplorerSplitter" Grid.Column="3" Theme="{StaticResource TKCode.Splitter}"
                              ResizeDirection="Columns" IsVisible="False" />

                <!-- ============ 文件树 ============ -->
                <DockPanel x:Name="ExplorerColumn" Grid.Column="4" IsVisible="False" ClipToBounds="True" Background="{DynamicResource TKCode.SidebarBg}">
                    <Panel DockPanel.Dock="Top" Height="44" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />
                    <Border DockPanel.Dock="Top" Classes="inputBox" Margin="8,0,8,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,2,0">
                            <icons:LucideIcon Kind="Search" Width="13" Height="13" StrokeBrush="{DynamicResource TKCode.TextTertiary}" />
                            <arc:Input Grid.Column="1" Size="Small" Classes="bare"
                                           Placeholder="{loc:TKCodeLangResource SearchFiles}" Text="{Binding Explorer.Search, Mode=TwoWay}" />
                            <Button Grid.Column="2" Theme="{StaticResource TKCode.RowButton}" Width="24" MinHeight="24" Padding="0"
                                    HorizontalContentAlignment="Center" Classes.selected="{Binding Explorer.ShowHidden}"
                                    Command="{Binding Explorer.ToggleHiddenCommand}" ToolTip.Tip="{loc:TKCodeLangResource ShowHiddenFiles}">
                                <Panel>
                                    <icons:LucideIcon Kind="EyeOff" Width="13" Height="13" IsVisible="{Binding !Explorer.ShowHidden}" />
                                    <icons:LucideIcon Kind="Eye" Width="13" Height="13" IsVisible="{Binding Explorer.ShowHidden}" />
                                </Panel>
                            </Button>
                        </Grid>
                    </Border>
                    <Panel>
                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource NoWorkspaceFiles}" Margin="16,8" TextWrapping="Wrap"
                                   IsVisible="{Binding !Explorer.HasRoot}" />
                        <Grid IsVisible="{Binding Explorer.HasRoot}">
                            <controls:FileExplorerTree x:Name="ExplorerTree" Explorer="{Binding Explorer}" IsVisible="{Binding !Explorer.IsSearching}"
                                                       Margin="4,0,4,8" Background="Transparent" BorderThickness="0" CornerRadius="0" FontSize="12"
                                                       AutomationProperties.Name="{loc:TKCodeLangResource SearchFiles}" />
                            <arc:ScrollArea x:Name="ExplorerSearchScroll" IsVisible="{Binding Explorer.IsSearching}"
                                            Background="Transparent" PointerPressed="OnExplorerSearchBlankPointerPressed">
                                <ItemsControl x:Name="ExplorerSearchResults" ItemsSource="{Binding Explorer.SearchResults}" Margin="4,0,4,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FileNodeViewModel">
                                            <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="26" Padding="0,0,8,0"
                                                    ToolTip.Tip="{Binding FullPath}"
                                                    PointerPressed="OnExplorerSearchRowPointerPressed" KeyDown="OnExplorerSearchRowKeyDown"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Explorer.ActivateCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                                                    <icons:FileTypeIcon Kind="{Binding Icon}" ColorKey="{Binding IconColor}" Width="16" Height="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Classes="tertiary" Text="{Binding Hint}" FontSize="11" VerticalAlignment="Center"
                                                               IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </arc:ScrollArea>
                        </Grid>
                    </Panel>
                </DockPanel>

                <!-- ============ 右上角：文件树 / 编辑区开关（始终位于最右一栏顶部） ============ -->
                <StackPanel x:Name="PanelToggles" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Height="44" Margin="0,0,8,0">
                    <Button Theme="{StaticResource TKCode.RowButton}" Width="28" MinHeight="28" Padding="0" HorizontalContentAlignment="Center"
                            VerticalAlignment="Center" Classes.selected="{Binding IsExplorerOpen}" Command="{Binding ToggleExplorerCommand}"
                            WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{loc:TKCodeLangResource ToggleExplorer}">
                        <icons:LucideIcon Kind="FolderTree" Width="15" Height="15" />
                    </Button>
                    <Button Theme="{StaticResource TKCode.RowButton}" Width="28" MinHeight="28" Padding="0" HorizontalContentAlignment="Center"
                            VerticalAlignment="Center" Classes.selected="{Binding IsWorkbenchOpen}" Command="{Binding ToggleWorkbenchCommand}"
                            WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{loc:TKCodeLangResource ToggleWorkbench}">
                        <icons:LucideIcon Kind="PanelRight" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ 设置页 ============ -->
        <!-- 设置页与主界面：设置页从略大处缩回并淡入，主界面淡出 -->
        <views:SettingsView x:Name="SettingsPage" motion:Presence.IsPresent="{Binding IsSettingsOpen}" motion:Presence.Effect="Zoom" motion:Presence.Distance="0" />

        <!-- ============ 更新提醒（右下角，主界面与设置页上都显示） ============ -->
        <views:UpdateCardView DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                              motion:Presence.IsPresent="{Binding IsCardVisible}" motion:Presence.Effect="SlideUp" />

        <!-- ============ ⌘K 命令面板 ============ -->
        <!-- 遮罩淡入，卡片从上方轻微缩放落下 -->
        <Grid x:Name="PaletteOverlay" RowDefinitions="1*,Auto,2*" motion:Presence.IsPresent="{Binding Palette.IsOpen}">
            <Border Grid.RowSpan="3" Background="#40000000" PointerPressed="OnPaletteBackdropPressed" />
            <Border Grid.Row="1" Classes="menu" Width="580" HorizontalAlignment="Center"
                    motion:Presence.IsPresent="{Binding Palette.IsOpen}" motion:Presence.Effect="Zoom" motion:Presence.Distance="12">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,6,12,6">
                        <icons:LucideIcon Kind="Search" Width="15" Height="15" StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                        <arc:Input x:Name="PaletteSearch" Grid.Column="1" Classes="bare" Margin="4,0"
                                       Placeholder="{Binding Palette.Placeholder}" Text="{Binding Palette.Search, Mode=TwoWay}" />
                        <Border Grid.Column="2" Classes="kbd">
                            <TextBlock Text="{Binding Palette.HotkeyHint}" />
                        </Border>
                    </Grid>
                    <Border Classes="menuDivider" />
                    <!-- 子页面包屑：← | 新建项目 -->
                    <motion:Reveal IsOpen="{Binding Palette.HasBreadcrumb}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,8,10,0">
                        <Button Theme="{StaticResource TKCode.RowButton}" Width="26" MinHeight="26" Padding="0" HorizontalContentAlignment="Center"
                                Command="{Binding Palette.BackCommand}" ToolTip.Tip="{loc:TKCodeLangResource Back}">
                            <icons:LucideIcon Kind="ArrowLeft" Width="13" Height="13" />
                        </Button>
                        <Border Width="1" Height="14" Background="{DynamicResource TKCode.MenuBorder}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource TKCode.KbdBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Classes="strong" Text="{Binding Palette.Breadcrumb}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    </motion:Reveal>
                    <!-- 结果数量变化时高度平滑过渡；进入 / 返回子页时列表横向滑入 -->
                    <motion:SmoothSize>
                    <arc:ScrollArea x:Name="PaletteList" MaxHeight="340">
                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TKCode.MenuItemHoverBg}" IndicatorRadius="6">
                        <ItemsControl ItemsSource="{Binding Palette.Items}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteItemViewModel">
                                    <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsHighlighted}" MinHeight="32" Margin="0,1"
                                            motion:IndicatorPanel.IsCurrent="{Binding IsHighlighted}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Palette.ExecuteCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Panel Width="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <icons:LucideIcon Kind="{Binding Icon}" Width="14" Height="14" IsVisible="{Binding !HasLogo}"
                                                                  StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                                                <icons:ProviderLogo Key="{Binding LogoKey}" Width="14" Height="14" IsVisible="{Binding HasLogo}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="strong" Text="{Binding Title}" VerticalAlignment="Center"
                                                       MaxWidth="380" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding Subtitle}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{DynamicResource TKCode.Success}" Margin="8,0"
                                                     IsVisible="{Binding IsOnline}" VerticalAlignment="Center" />
                                            <Border Grid.Column="4" Classes="kbd" IsVisible="{Binding Shortcut, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{Binding Shortcut}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </motion:IndicatorPanel>
                    </arc:ScrollArea>
                    </motion:SmoothSize>
                    <motion:Reveal IsOpen="{Binding Palette.IsEmpty}">
                        <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource NoResults}" FontSize="12" Margin="18,4,0,12" />
                    </motion:Reveal>
                    <Border Classes="menuDivider" />
                    <!-- 键位提示 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,8">
                        <Border Classes="kbd"><TextBlock Text="↑" /></Border>
                        <Border Classes="kbd"><TextBlock Text="↓" /></Border>
                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource HintNavigate}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Classes="kbd"><TextBlock Text="↵" /></Border>
                        <Panel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource HintSelect}" IsVisible="{Binding !Palette.OpenHint}" />
                            <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource HintOpen}" IsVisible="{Binding Palette.OpenHint}" />
                        </Panel>
                        <Border Classes="kbd"><TextBlock Text="esc" /></Border>
                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource HintClose}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Windows / Linux 自绘窗口按钮（macOS 使用原生红绿灯） -->
        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="44" IsVisible="False">
            <arc:Button Classes="caption" Variant="Ghost" Width="46" Height="44" WindowDecorationProperties.ElementRole="MinimizeButton" arc:Tooltip.Tip="{loc:TKCodeLangResource Minimize}"
                        Click="OnMinimizeClick" AutomationProperties.Name="{loc:TKCodeLangResource Minimize}">
                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="ChevronDown" />
            </arc:Button>
            <arc:Button Classes="caption" Variant="Ghost" Width="46" Height="44" WindowDecorationProperties.ElementRole="MaximizeButton" arc:Tooltip.Tip="{loc:TKCodeLangResource Maximize}"
                        Click="OnMaximizeClick" AutomationProperties.Name="{loc:TKCodeLangResource Maximize}">
                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="Maximize" />
            </arc:Button>
            <arc:Button Classes="caption" Variant="Ghost" Width="46" Height="44" WindowDecorationProperties.ElementRole="CloseButton" arc:Tooltip.Tip="{loc:TKCodeLangResource Close}"
                        Click="OnCloseClick" AutomationProperties.Name="{loc:TKCodeLangResource Close}">
                <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="X" />
            </arc:Button>
        </StackPanel>
    </Grid>
    </controls:ZoomHost>
</atom:Window>
