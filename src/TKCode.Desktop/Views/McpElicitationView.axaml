<!--
  MCP 服务器的 elicitation 请求（docs/design/mcp.md §8.3，规格 §5.1）：显示在输入框上方，与工具审批卡片同一位置。
  form：按受限 schema 生成表单；url：显示完整 URL 并突出域名，确认后用系统浏览器打开。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.McpElicitationView"
             x:DataType="vm:McpElicitationViewModel">
    <Border Classes="card" Padding="14,12" BorderBrush="{DynamicResource TKCode.Accent}">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <icons:LucideIcon Kind="Plug" Width="15" Height="15" VerticalAlignment="Center" StrokeBrush="{DynamicResource TKCode.Accent}" />
                <TextBlock Classes="strong" Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- 服务器的说明：纯文本，不渲染链接 -->
            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />

            <!-- URL 模式 -->
            <StackPanel Spacing="6" IsVisible="{Binding IsUrl}">
                <Border Background="{DynamicResource TKCode.CodeBg}" CornerRadius="6" Padding="10,6">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="strong" Text="{Binding UrlHost}" FontSize="13" />
                        <SelectableTextBlock Text="{Binding Url}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="11" TextWrapping="Wrap"
                                             Foreground="{DynamicResource TKCode.TextSecondary}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:TKCodeLangResource McpElicitPunycode}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" TextWrapping="Wrap"
                           IsVisible="{Binding IsPunycode}" />
                <TextBlock Text="{loc:TKCodeLangResource McpElicitInsecure}" FontSize="12" Foreground="{DynamicResource TKCode.GitModified}" TextWrapping="Wrap"
                           IsVisible="{Binding IsInsecure}" />
                <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource McpElicitUrlHint}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 表单 -->
            <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding ShowFormFields}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:McpFieldViewModel">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="secondary" Text="{Binding Label}" FontSize="12" IsVisible="{Binding !IsBoolean}" />
                            <arc:Input Size="Small" Text="{Binding TextValue, Mode=TwoWay}" IsVisible="{Binding IsText}" />
                            <arc:Input Size="Small" Text="{Binding TextValue, Mode=TwoWay}" IsVisible="{Binding IsNumber}" Width="200" HorizontalAlignment="Left" />
                            <arc:Checkbox IsChecked="{Binding BoolValue, Mode=TwoWay}" Content="{Binding Label}" IsVisible="{Binding IsBoolean}" />
                            <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsChoice}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpFieldOptionViewModel">
                                        <Button Theme="{StaticResource TKCode.ChipButton}" Classes.selected="{Binding IsSelected}" Margin="0,0,6,6"
                                                Command="{Binding $parent[ItemsControl].((vm:McpFieldViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:LucideIcon Kind="Check" Width="11" Height="11" IsVisible="{Binding IsSelected}" />
                                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsMultiChoice}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpFieldOptionViewModel">
                                        <arc:Checkbox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" Margin="0,0,12,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="tertiary" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                            <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" IsVisible="{Binding HasError}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 不支持的表单 -->
            <StackPanel Spacing="4" IsVisible="{Binding IsUnsupported}">
                <TextBlock Text="{loc:TKCodeLangResource McpElicitUnsupported}" FontSize="12" Foreground="{DynamicResource TKCode.GitModified}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding SchemaText}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="11" TextWrapping="Wrap" MaxHeight="120"
                                     Foreground="{DynamicResource TKCode.TextSecondary}" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" IsVisible="{Binding HasError}" />

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding CancelCommand}" Content="{loc:TKCodeLangResource Cancel}" />
                <arc:Button Variant="Secondary" Size="Small" Command="{Binding DeclineCommand}" Content="{loc:TKCodeLangResource McpElicitDecline}" />
                <arc:Button Variant="Primary" Size="Small" Command="{Binding SubmitCommand}" IsVisible="{Binding IsForm}"
                            IsEnabled="{Binding CanSubmit}" Content="{loc:TKCodeLangResource McpElicitSubmit}" />
                <arc:Button Variant="Primary" Size="Small" Command="{Binding SubmitCommand}" IsVisible="{Binding IsUrl}"
                            IsEnabled="{Binding CanSubmit}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:LucideIcon StrokeBrush="{Binding $parent[arc:Button].Foreground}" Width="14" Height="14" Kind="ExternalLink" />
                        <TextBlock Text="{loc:TKCodeLangResource McpElicitOpenUrl}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
