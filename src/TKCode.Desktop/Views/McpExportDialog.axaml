<!--
  导出 MCP 服务器（设置 › MCP 服务器）：通用 {"mcpServers": …} 格式，可复制或另存为文件。
  经 ScaledModal 显示，跟随界面缩放；Esc、点遮罩、关闭按钮都会关闭。
-->
<arc:DialogSurface xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                   xmlns:vm="using:TKCode.Desktop.ViewModels"
                   xmlns:loc="using:TKCode.Desktop.Localization"
                   x:Class="TKCode.Desktop.Views.McpExportDialog"
                   x:DataType="vm:McpExportViewModel"
                   Size="Large" ShowCloseButton="True" ContentTemplate="{x:Null}"
                   Title="{loc:TKCodeLangResource McpExportTitle}" Description="{loc:TKCodeLangResource McpExportHint}">
    <arc:DialogSurface.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <arc:Button Variant="Secondary" Click="OnSave" Content="{loc:TKCodeLangResource SaveToFile}" />
            <arc:Button Variant="Primary" Click="OnCopy" Content="{loc:TKCodeLangResource CopyToClipboard}" />
        </StackPanel>
    </arc:DialogSurface.Actions>
    <StackPanel Spacing="12">
        <Border Classes="card" Padding="12,10">
            <!-- 长行（URL、环境变量）横向滚动，不换行 -->
            <arc:ScrollArea MaxHeight="340" Orientation="Both">
                <SelectableTextBlock Text="{Binding Json}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12" Margin="0,0,12,12" />
            </arc:ScrollArea>
        </Border>
        <arc:Checkbox IsChecked="{Binding Expand, Mode=TwoWay}" Content="{loc:TKCodeLangResource McpExportExpand}" />
    </StackPanel>
</arc:DialogSurface>
