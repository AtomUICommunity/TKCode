<!-- 工具步骤行：read 只显示一行，点击在工作区打开文件；其他工具点击展开完整参数与输出。活动组与查阅组共用。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:motion="using:TKCode.Desktop.Motion"
             xmlns:views="using:TKCode.Desktop.Views"
             x:Class="TKCode.Desktop.Views.ToolStepView"
             x:DataType="vm:ToolCallBlockViewModel">
<StackPanel>
                                                                <!-- read 只显示一行（文件图标 + 文件名 + 目录），点击打开工作区预览；其他工具点击展开 -->
                                                                <Button Theme="{StaticResource TKCode.TextButton}" HorizontalAlignment="Stretch" MinHeight="30" Padding="0,0,6,0"
                                                                        Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding Duration}">
                                                                    <Grid ColumnDefinitions="10,Auto,Auto,*,Auto,Auto">
                                                                        <Border Height="1" Background="{DynamicResource TKCode.TreeLine}" VerticalAlignment="Center" />
                                                                        <icons:LucideIcon Grid.Column="1" Kind="{Binding Icon}" Width="14" Height="14" Margin="6,0,8,0"
                                                                                          VerticalAlignment="Center" StrokeBrush="{Binding $parent[Button].Foreground}" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Verb}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding Summary}" FontSize="13"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <!-- 完成后：耗时；命令非零退出时加退出码 -->
                                                                        <TextBlock Grid.Column="4" Classes="tertiary" Text="{Binding TrailingText}" FontSize="12" Margin="8,0,0,0"
                                                                                   VerticalAlignment="Center" IsVisible="{Binding TrailingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                        <Panel Grid.Column="5" Width="14" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <controls:DotSpinner Width="11" Height="11" IsVisible="{Binding IsBusy}" />
                                                                            <icons:LucideIcon Kind="X" Width="13" Height="13" IsVisible="{Binding IsFailed}"
                                                                                              StrokeBrush="{DynamicResource TKCode.Danger}" />
                                                                            <icons:LucideIcon Kind="ChevronDown" Width="12" Height="12" motion:Presence.IsPresent="{Binding IsExpanded}" motion:Presence.Effect="Pop"
                                                                                              IsVisible="{Binding !IsRead}" StrokeBrush="{Binding $parent[Button].Foreground}" />
                                                                        </Panel>
                                                                    </Grid>
                                                                </Button>
                                                                <motion:Reveal IsOpen="{Binding IsExpanded}">
    <!-- 详情只在展开时创建，收起动画播完后释放 -->
    <motion:Reveal.ContentTemplate>
        <DataTemplate x:DataType="vm:ToolCallBlockViewModel">
            <views:ToolCallDetailView />
        </DataTemplate>
    </motion:Reveal.ContentTemplate>
</motion:Reveal>
                                                            </StackPanel>
</UserControl>
