<!--
  TKCode 复合控件的主题与文字层级。
  可交互的通用按钮使用 Arc 的 arc:Button；这里只为侧栏行、磁贴、标签页、分割条等
  Arc 没有对应形态的表面提供 ControlTheme。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="using:TKCode.Desktop.Motion"
        xmlns:controls="using:TKCode.Desktop.Controls"
        xmlns:composer="using:TKCode.Desktop.Controls.Composer"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc">
    <Styles.Resources>
        <!-- 侧栏导航、列表行、菜单行：透明背景，悬停/选中时填充 -->
        <ControlTheme x:Key="TKCode.RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="{StaticResource TKCode.RadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 悬停 / 按下 / 选中：颜色渐变而不是瞬间切换；按下轻微缩小（只用于胶囊、磁贴这类独立按钮，见下方主题） -->
            <Setter Property="Transitions">
                <Transitions>
                    <motion:MotionBrushTransition Property="Background" />
                    <motion:MotionBrushTransition Property="BorderBrush" />
                    <motion:MotionBrushTransition Property="Foreground" />
                    <motion:MotionTransformTransition Property="RenderTransform" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TKCode.HoverBg}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource TKCode.SelectedBg}" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{DynamicResource TKCode.SelectedBg}" />
            </Style>
        </ControlTheme>

        <!-- 工作台起始页磁贴 -->
        <ControlTheme x:Key="TKCode.TileButton" TargetType="Button" BasedOn="{StaticResource TKCode.RowButton}">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource TKCode.RadiusMedium}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TKCode.TileBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TKCode.TileHoverBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TKCode.TileHoverBorder}" />
                <Setter Property="RenderTransform" Value="translateY(-2px)" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </ControlTheme>

        <!-- 工作台标签页 -->
        <ControlTheme x:Key="TKCode.TabButton" TargetType="Button" BasedOn="{StaticResource TKCode.RowButton}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0,6,0" />
            <Style Selector="^.active">
                <Setter Property="Background" Value="{DynamicResource TKCode.TabActiveBg}" />
            </Style>
        </ControlTheme>

        <!-- 胶囊按钮（Plan New Idea / Multitask / 上下文选择器） -->
        <ControlTheme x:Key="TKCode.PillButton" TargetType="Button" BasedOn="{StaticResource TKCode.RowButton}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TKCode.PillBorder}" />
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
        </ControlTheme>

        <!-- 无边框的文字下拉（仓库 ⌄ / 分支 ⌄ / 环境 ⌄） -->
        <ControlTheme x:Key="TKCode.ChipButton" TargetType="Button" BasedOn="{StaticResource TKCode.RowButton}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TKCode.TextSecondary}" />
            <Setter Property="Padding" Value="6,0" />
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
            </Style>
            <!-- 不做按下缩放：它是弹层的触发按钮，AtomUI 弹层按按钮当时（缩放中）的边界定位，会固定偏几个像素 -->
        </ControlTheme>

        <!-- 会话里的步骤行与活动组标题：悬停 / 按下只提亮文字，不填充背景。行内文字与图标跟随 Foreground -->
        <ControlTheme x:Key="TKCode.TextButton" TargetType="Button" BasedOn="{StaticResource TKCode.ChipButton}">
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ControlTheme>

        <!-- 弹层菜单项：比 RowButton 更紧凑，悬停色更亮（模型选择器、项目 / 分支选择器、命令面板） -->
        <ControlTheme x:Key="TKCode.MenuItem" TargetType="Button" BasedOn="{StaticResource TKCode.RowButton}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TKCode.MenuItemHoverBg}" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{DynamicResource TKCode.MenuItemHoverBg}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
            </Style>
        </ControlTheme>

        <!-- 图标页签：选中时底部 2px 强调色下划线（模型选择器顶部的 Provider 页签） -->
        <ControlTheme x:Key="TKCode.IconTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TKCode.TextSecondary}" />
            <Setter Property="Transitions">
                <Transitions>
                    <motion:MotionBrushTransition Property="Foreground" />
                    <motion:MotionTransformTransition Property="RenderTransform" />
                </Transitions>
            </Setter>
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- 下划线：选中时从中间展开 -->
                        <Border x:Name="PART_Underline" Height="2" Margin="7,0" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource TKCode.Accent}" Opacity="0" RenderTransform="scaleX(0.2)">
                            <Border.Transitions>
                                <Transitions>
                                    <motion:MotionDoubleTransition Property="Opacity" />
                                    <motion:MotionTransformTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{x:Static motion:MotionTokens.EaseSpring}" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.92)" />
            </Style>
            <Style Selector="^.active">
                <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
                <Style Selector="^ /template/ Border#PART_Underline">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="scaleX(1)" />
                </Style>
            </Style>
        </ControlTheme>

        <!-- 输入框的发送 / 停止：强调色实心圆，无描边无投影；不可用时整体变淡（箭头像镂空），而不是换成描边样式。
             状态只作用在模板里的圆上：按钮自身的透明度 / 变换留给 motion:Presence 的弹出切换 -->
        <ControlTheme x:Key="TKCode.SendButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TKCode.AccentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TKCode.AccentFg}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Disk" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <motion:MotionDoubleTransition Property="Opacity" />
                                <motion:MotionTransformTransition Property="RenderTransform" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Disk">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Disk">
                <Setter Property="RenderTransform" Value="scale(0.9)" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Cursor" Value="Arrow" />
                <Style Selector="^ /template/ Border#PART_Disk">
                    <Setter Property="Opacity" Value="0.3" />
                </Style>
            </Style>
        </ControlTheme>

        <!-- 悬停卡片：触发内容 + 弹层；弹层里的卡片四周留出阴影空间（HoverCard.ShadowMargin），偏移在代码里按放置方向换算 -->
        <ControlTheme x:Key="{x:Type controls:HoverCard}" TargetType="controls:HoverCard">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <motion:Popover x:Name="PART_Popup">
                            <controls:ZoomHost>
                                <ContentPresenter x:Name="PART_CardHost" Content="{TemplateBinding Card}" />
                            </controls:ZoomHost>
                        </motion:Popover>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- 信息卡片外壳：与弹层菜单同一套表面（背景、描边、圆角、投影）；标题行 · 正文 · 分隔线 · 底栏 -->
        <ControlTheme x:Key="{x:Type controls:InfoCard}" TargetType="controls:InfoCard">
            <Setter Property="Background" Value="{DynamicResource TKCode.MenuBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TKCode.MenuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource TKCode.RadiusMenu}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{StaticResource TKCode.MenuShadow}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"
                                  IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TKCode.TextPrimary}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Extra}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  FontSize="12" Foreground="{DynamicResource TKCode.TextSecondary}" />
                            </Grid>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <StackPanel IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Border Height="1" Margin="0,12,0,10" Background="{DynamicResource TKCode.MenuBorder}" />
                                <ContentPresenter Content="{TemplateBinding Footer}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- 卡片里的一行统计：色点 · 标签（次要文字）· 右对齐数值（主要文字） -->
        <ControlTheme x:Key="{x:Type controls:CardStatRow}" TargetType="controls:CardStatRow">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{TemplateBinding Marker}"
                                 IsVisible="{TemplateBinding Marker, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TKCode.TextSecondary}" />
                        <TextBlock Grid.Column="2" Text="{TemplateBinding Value}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TKCode.TextPrimary}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="TKCode.Splitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource TKCode.Divider}" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 视觉上 1px，命中区域左右各扩 3px -->
                    <Border Background="Transparent" Margin="-3,0">
                        <Border Background="{TemplateBinding Background}" Width="1" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- 弹层卡片：半透明深色、低对比描边、柔和投影 -->
    <Style Selector="Border.menu">
        <Setter Property="Background" Value="{DynamicResource TKCode.MenuBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TKCode.MenuBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TKCode.RadiusMenu}" />
        <Setter Property="BoxShadow" Value="{StaticResource TKCode.MenuShadow}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.menuDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TKCode.MenuBorder}" />
    </Style>

    <!-- 设置页卡片与分组行 -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource TKCode.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TKCode.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TKCode.RadiusMedium}" />
    </Style>
    <!-- 分段选择：外框 + 选中项填充 -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource TKCode.MenuInputBg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.segmented Button">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- 选中底板由 motion:IndicatorPanel 画，在选项之间滑动；选项自己不再填充 -->
    <Style Selector="Border.segmented Button.selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.segmented Button.selected:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 命令面板：高亮底板在结果之间滑动 -->
    <Style Selector="Border.menu motion|IndicatorPanel Button.selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 页签：下划线由 IndicatorPanel 画并在页签之间滑动，页签自己的下划线隐藏 -->
    <Style Selector="motion|IndicatorPanel Button.active /template/ Border#PART_Underline">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.segmented Button">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.inputBox">
        <Setter Property="Background" Value="{DynamicResource TKCode.MenuInputBg}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- 只有图标的 Arc 按钮（标题栏、工具栏、卡片角上的关闭）：正方形，与原来的小号图标按钮同高 -->
    <Style Selector="arc|Button.icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Windows / Linux 自绘的窗口按钮：贴边的矩形，按下不缩放 -->
    <Style Selector="arc|Button.caption">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsPressScaleEnabled" Value="False" />
    </Style>
    <!-- 嵌在自绘外框里的 Arc 输入框（菜单与面板里的搜索、“其他”输入、计划编辑）：去掉 Arc 自己的边框与底色，
         高度跟随文字而不是 Arc 的控件尺寸，外框的高度由所在的行决定 -->
    <Style Selector=":is(arc|FieldTextBox).bare /template/ arc|FieldFrame#PART_Frame">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- 键位提示：⌘1、esc、↵ -->
    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{DynamicResource TKCode.KbdBg}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TKCode.KbdFg}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--
      文字层级。注意：不要给所有 TextBlock 设置 Foreground / FontSize ——
      那会覆盖 AtomUI 控件模板内部的文字（实心按钮、危险按钮、复选框、小号控件），导致亮 / 暗主题下文字不可见或字号错乱。
      正文颜色由窗口的 Foreground 继承（MainWindow.Foreground = TKCode.TextPrimary），层级通过样式类表达。
    -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TKCode.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource TKCode.TextTertiary}" />
        <Setter Property="FontSize" Value="{StaticResource TKCode.FontSizeSmall}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{DynamicResource TKCode.TextTertiary}" />
        <Setter Property="FontSize" Value="{StaticResource TKCode.FontSizeSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 侧栏项目行（docs/design/projects.md §8.3）：悬停或菜单打开时显示行内操作，名称在操作前截断 -->
    <Style Selector="Grid.projectRow StackPanel.rowActions">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Grid.projectRow:pointerover StackPanel.rowActions, Grid.projectRow.menuOpen StackPanel.rowActions">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Grid.projectRow:pointerover Button.projectRowButton, Grid.projectRow.menuOpen Button.projectRowButton">
        <Setter Property="Background" Value="{DynamicResource TKCode.HoverBg}" />
    </Style>
    <Style Selector="Grid.projectRow:pointerover Button.projectRowButton.selected, Grid.projectRow.menuOpen Button.projectRowButton.selected">
        <Setter Property="Background" Value="{DynamicResource TKCode.SelectedBg}" />
    </Style>
    <Style Selector="Grid.projectRow:pointerover StackPanel.projectMarks, Grid.projectRow.menuOpen StackPanel.projectMarks">
        <Setter Property="Margin" Value="6,0,44,0" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="#553B82F6" />
    </Style>
    <!-- 输入框（docs/design/composer.md §6.2）：tag 用强调色的浅底 -->
    <Style Selector="composer|ComposerEditor">
        <Setter Property="Foreground" Value="{DynamicResource TKCode.TextPrimary}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TKCode.TextTertiary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TKCode.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="#553B82F6" />
        <Setter Property="TagBackground" Value="{DynamicResource TKCode.AccentSoftBg}" />
        <Setter Property="TagForeground" Value="{DynamicResource TKCode.AccentText}" />
    </Style>
</Styles>
