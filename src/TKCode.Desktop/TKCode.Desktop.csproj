<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>TKCode.Desktop</RootNamespace>
        <AssemblyName>TKCode</AssemblyName>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <!-- LibraryImport / GeneratedComInterface（Services/WindowsJumpList.cs）的源生成代码需要 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Windows 可执行文件图标（资源管理器、任务栏）；macOS/Linux 使用 Packaging 下的 icns / hicolor PNG -->
        <ApplicationIcon>Packaging\app.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- 整个客户端必须支持 NativeAOT：发布默认 AOT，构建期启用 AOT / 裁剪分析器 -->
        <PublishAot>true</PublishAot>
        <!-- .NET 11 的精简 AOT 发布会在 ResolveReferences 前处理资源；Avalonia 需要完整 Build 收集并预编译 XAML。 -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AtomUI.Desktop.Controls" />
        <!-- 冒烟模式（TKCode smoke 参数）在发布后的二进制中以无头平台运行真实界面 -->
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="TKCode.StreamMark.Avalonia" />
        <PackageReference Include="TKCode.StreamMark.RaTeX" />
        <PackageReference Include="TKCode.StreamMark.Highlighting.TextMate" />
        <PackageReference Include="TKCode.StreamMark.Mermaid" />
        <PackageReference Include="TKCode.StreamMark.Theme.AtomUI" />
        <PackageReference Include="TKCode.Arc" />
        <PackageReference Include="TKCode.Arc.Icons.Lucide" />
        <PackageReference Include="TKCode.Arc.Terminal" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\TKCode.Rpc.Contracts\TKCode.Rpc.Contracts.csproj" />
        <ProjectReference Include="..\TKCode.Config\TKCode.Config.csproj" />
        <ProjectReference Include="..\TKCode.Shell\TKCode.Shell.csproj" />
        <!-- Agent Host 作为独立进程运行；引用它只为保证先构建并把产物复制到 agenthost/ 目录 -->
        <ProjectReference Include="..\TKCode.AgentHost\TKCode.AgentHost.csproj" ReferenceOutputAssembly="false" />
        <!-- 终端：视图与协议库；pty host 作为独立进程（04 §1.1），同样只为先构建并复制产物到 ptyhost/ 目录 -->
        <ProjectReference Include="..\TKCode.Terminal.Protocol\TKCode.Terminal.Protocol.csproj" />
        <ProjectReference Include="..\TKCode.Terminal.Host\TKCode.Terminal.Host.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- 把 Agent Host 的构建产物复制到桌面端输出的 agenthost/ 子目录，运行时由 AgentHostConnection 启动 -->
    <Target Name="CopyAgentHost" AfterTargets="Build">
        <MSBuild Projects="..\TKCode.AgentHost\TKCode.AgentHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_AgentHostTargetPath" />
        </MSBuild>
        <PropertyGroup>
            <_AgentHostDir>@(_AgentHostTargetPath->'%(RootDir)%(Directory)')</_AgentHostDir>
        </PropertyGroup>
        <ItemGroup>
            <_AgentHostFiles Include="$(_AgentHostDir)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_AgentHostFiles)" DestinationFiles="@(_AgentHostFiles->'$(OutDir)agenthost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!-- 把 pty host（含 libghostty-vt、tkcode-pty-spawn、Windows 的 ConPTY）复制到桌面端输出的 ptyhost/ 子目录（04 §1.1） -->
    <Target Name="CopyPtyHost" AfterTargets="Build">
        <MSBuild Projects="..\TKCode.Terminal.Host\TKCode.Terminal.Host.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_PtyHostTargetPath" />
        </MSBuild>
        <PropertyGroup>
            <_PtyHostDir>@(_PtyHostTargetPath->'%(RootDir)%(Directory)')</_PtyHostDir>
        </PropertyGroup>
        <ItemGroup>
            <_PtyHostFiles Include="$(_PtyHostDir)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_PtyHostFiles)" DestinationFiles="@(_PtyHostFiles->'$(OutDir)ptyhost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!-- 发布桌面端时，用相同的运行时标识把 pty host 也 AOT 发布到 ptyhost/ 子目录 -->
    <Target Name="PublishPtyHost" AfterTargets="Publish">
        <MSBuild Projects="..\TKCode.Terminal.Host\TKCode.Terminal.Host.csproj" Targets="Publish"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishAot=$(PublishAot);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)ptyhost'))/" />
    </Target>

    <!-- 发布桌面端时，用相同的运行时标识把 Agent Host 也 AOT 发布到 agenthost/ 子目录 -->
    <Target Name="PublishAgentHost" AfterTargets="Publish">
        <MSBuild Projects="..\TKCode.AgentHost\TKCode.AgentHost.csproj" Targets="Publish"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishAot=$(PublishAot);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)agenthost'))/" />
    </Target>
</Project>
