<Application xmlns:smt="using:StreamMark.Avalonia.Themes"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TKCode.Desktop.App"
             Name="TKCode">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TKCode/Styling/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <StyleInclude Source="avares://TKCode/Styling/Controls.axaml" />
        <!-- StreamMark：默认 Markdown 外观；Arc 的 Markdown 控件按主题映射 Md.* 资源 -->
        <smt:StreamMarkTheme />
    </Application.Styles>
</Application>
