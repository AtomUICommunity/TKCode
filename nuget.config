<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- StreamMark 本地包：tools/streammark/pack.sh 从子模块 external/StreamMark 打包到这里 -->
    <add key="streammark-local" value="packages/streammark" />
  </packageSources>
  <packageSourceMapping>
    <!-- 包 ID 与 nuget.org 上的一致（TKCode.StreamMark.*）：TKCode.Arc 依赖同名包，程序集名也相同。
         仍只从本地源还原，保证用的是子模块构建、含各 RID 原生库的那一份。 -->
    <packageSource key="streammark-local">
      <package pattern="TKCode.StreamMark.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
